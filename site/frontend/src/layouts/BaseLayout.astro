---
import { VisualEditing } from "@sanity/astro/visual-editing";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { cleanPath, path, type Lang } from "../data/site";
import { DEFAULT_OG_IMAGE, metaDescription } from "../data/seo";

interface Props {
  title: string;
  description?: string;
  /** Obraz do udostępniania (pełny URL); domyślnie og-default.jpg */
  image?: string;
  /** Typ treści dla Open Graph */
  ogType?: "website" | "article" | "profile";
  /** Dane strukturalne schema.org (JSON-LD) */
  jsonLd?: object | object[];
  /** Ścieżka aktywnej pozycji w nawigacji, np. "/faq" */
  active?: string;
  lang?: Lang;
  /** Adres tej samej strony w drugim języku (przełącznik PL / EN, hreflang) */
  alternate?: string;
}

const { title, active, lang = "pl", ogType = "website", jsonLd } = Astro.props;
const description = metaDescription(Astro.props.description);
const image = Astro.props.image ?? DEFAULT_OG_IMAGE;
const ldItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const other: Lang = lang === "en" ? "pl" : "en";
const alternate = Astro.props.alternate ?? path("home", other);
const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(cleanPath(Astro.url.pathname), site);
const urls = { [lang]: canonicalURL.href, [other]: new URL(alternate, site).href } as Record<Lang, string>;
const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === "true";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pl" href={urls.pl} />
    <link rel="alternate" hreflang="en" href={urls.en} />
    <link rel="alternate" hreflang="x-default" href={urls.pl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1a2440" />
    <link rel="preload" href="/fonts/PPNeueMontreal-Book.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/PPNeueMontreal-Medium.otf" as="font" type="font/otf" crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="ZMW Legal" />
    <meta property="og:locale" content={lang === "en" ? "en_GB" : "pl_PL"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "pl_PL" : "en_GB"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={image} />
    {ldItems.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <script is:inline>document.documentElement.classList.add('js-ready')</script>
    <Nav lang={lang} active={active} alternate={alternate} />
    <slot />
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
    <script>
      import Lenis from "lenis";
      const lenis = new Lenis();
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    </script>
    <slot name="scripts" />
    <VisualEditing enabled={visualEditingEnabled} />
  </body>
</html>
