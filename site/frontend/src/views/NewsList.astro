---
// Lista aktualności (PL: /aktualnosci, EN: /en/news) — karta wyróżniona, siatka, filtr kategorii, paginacja
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteScripts from "../components/SiteScripts.astro";
import { formatDate } from "../utils";
import { bgStyle } from "../utils/image";
import { getArticles } from "../utils/sanity";
import { ARTICLE_CATEGORIES, articlePath, categoryLabel, path, phone, type Lang } from "../data/site";
import "../styles/pages/aktualnosci.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === "en" ? "pl" : "en";

const t =
  lang === "en"
    ? {
        title: "News – rankings, awards and commentary | ZMW Legal",
        back: "‹ Home",
        heading: "News",
        desc: "Awards and rankings, new lawyers joining the team, academic partnerships and expert commentary. Follow what is happening at ZMW Legal.",
        category: "Category:",
        all: "All",
        featured: "Featured",
        older: "Older →",
        ctaLabel: "Contact us",
        cta: ["Interested in", "working with us?"],
        ctaLead: "We talk to the point. Call or write – we arrange meetings in person and online.",
        form: "Contact form",
      }
    : {
        title: "Aktualności – rankingi, nagrody i komentarze | ZMW Legal",
        back: "‹ Strona główna",
        heading: "Aktualności",
        desc: "Nagrody i rankingi, nowi prawnicy w zespole, partnerstwa akademickie i komentarze eksperckie. Śledź, co dzieje się w ZMW Legal.",
        category: "Kategoria:",
        all: "Wszystkie",
        featured: "Wyróżniony",
        older: "Starsze →",
        ctaLabel: "Skontaktuj się z nami",
        cta: ["Jesteś zainteresowany", "współpracą?"],
        ctaLead: "Rozmawiamy konkretnie. Zadzwoń lub napisz – umawiamy spotkania stacjonarne i online.",
        form: "Formularz kontaktowy",
      };

const articles = await getArticles(lang);
const featured = articles.find((a) => a.featured) ?? articles[0];
const rest = articles.filter((a) => a !== featured);
// Zakładki tylko dla kategorii, w których są artykuły (wartość = kategoria z Sanity, etykieta w języku strony)
const categories = ARTICLE_CATEGORIES.filter((c) => articles.some((a) => a.category === c));
const delay = (idx: number) => ["", "reveal-d1", "reveal-d2", "reveal-d3"][idx % 4];
---

<BaseLayout title={t.title} description={t.desc} active={path("news", lang)} lang={lang} alternate={path("news", other)}>
<!-- PAGE HEADER -->
<div class="page-header">
  <div class="page-header-inner">
    <div class="ph-left">
      <a href={path("home", lang)} class="ph-back reveal">{t.back}</a>
      <h1 class="ph-title">{t.heading}</h1>
    </div>
    <div class="ph-right">
      <p class="ph-desc reveal reveal-d1">{t.desc}</p>
    </div>
  </div>
</div>

<!-- FEATURED ARTICLE – najnowszy artykuł oznaczony w Sanity jako „Wyróżniony” -->
<div class="featured-section">
  <!-- FILTER BAR -->
  <div class="filter-wrap">
    <div class="filter-inner">
      <div class="filter-left">
        <span class="filter-lbl">{t.category}</span>
        <button class="filter-tab active" data-filter="*">{t.all}</button>
        {categories.map((c) => <button class="filter-tab" data-filter={c}>{categoryLabel(c, lang)}</button>)}
      </div>
    </div>
  </div>
  {featured && (
    <div class="wrap">
      <a href={articlePath(featured.slug.current, lang)} class:list={["featured-card", { "no-img": !featured.cover?.asset }]} data-cat={featured.category}>
        {featured.cover?.asset && (
          <div class="featured-img" style={bgStyle(featured.cover, 1200)}>
            <span class="featured-badge">{t.featured}</span>
          </div>
        )}
        <div class="featured-body">
          {!featured.cover?.asset && <span class="featured-badge">{t.featured}</span>}
          <p class="featured-cat">{categoryLabel(featured.category, lang)}</p>
          <h2 class="featured-title">{featured.title}</h2>
          <p class="featured-exc">{featured.excerpt}</p>
          <div class="featured-meta">
            <span class="featured-date">{formatDate(featured.publishedAt, lang)}</span>
            {featured.source && <Fragment><span class="featured-sep"></span><span>{featured.source}</span></Fragment>}
          </div>
        </div>
      </a>
    </div>
  )}
</div>

<!-- ARTICLES GRID -->
<div class="articles-section">
  <div class="wrap">
    <div class="articles-grid">
      {rest.map((a, idx) => (
        <a
          href={articlePath(a.slug.current, lang)}
          class:list={["article-card reveal", { "no-img": !a.cover?.asset }, delay(idx)]}
          data-cat={a.category}
        >
          {a.cover?.asset && <div class="article-img" style={bgStyle(a.cover, 800)}></div>}
          <p class="article-cat">{categoryLabel(a.category, lang)}</p>
          <h3 class="article-title">{a.title}</h3>
          <p class="article-exc">{a.excerpt}</p>
          <div class="article-meta">
            <span class="article-date">{formatDate(a.publishedAt, lang)}</span>
            <span class="article-sep"></span>
            <span>{categoryLabel(a.category, lang)}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- PAGINATION – budowana przez skrypt, gdy artykułów jest więcej niż PER_PAGE -->
    <div class="pagination" id="pagination" data-older={t.older}></div>
  </div>
</div>

<!-- CTA -->
<div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label">{t.ctaLabel}</span>
      <h2 class="kt-h2">{t.cta[0]}<br>{t.cta[1]}</h2>
      <p class="kt-lead reveal reveal-d1">{t.ctaLead}</p>
      <div class="btn-row reveal reveal-d2" style="justify-content:center">
        <a href={phone.href} class="btn-p" style="white-space:nowrap">{phone.display}</a>
        <a href={`${path("home", lang)}#kontakt`} class="btn-s">{t.form}</a>
      </div>
    </div>
  </div>
</div>

  <Fragment slot="scripts">
<script is:inline>
// Filtr kategorii + paginacja po stronie przeglądarki (9 artykułów na stronę)
(function(){
  var PER_PAGE=9;
  var tabs=document.querySelectorAll('.filter-tab');
  var cards=[].slice.call(document.querySelectorAll('.article-card'));
  var featuredSection=document.querySelector('.featured-section .wrap');
  var featuredCard=document.querySelector('.featured-card');
  var pag=document.getElementById('pagination');
  var cat='*',page=1;
  function matches(el){return cat==='*'||el.dataset.cat===cat;}
  function render(){
    var visible=cards.filter(matches);
    var pages=Math.max(1,Math.ceil(visible.length/PER_PAGE));
    if(page>pages)page=pages;
    cards.forEach(function(c){c.style.display='none';});
    visible.slice((page-1)*PER_PAGE,page*PER_PAGE).forEach(function(c){c.style.display='';c.classList.add('visible');});
    if(featuredSection&&featuredCard){featuredSection.style.display=matches(featuredCard)&&page===1?'':'none';}
    pag.innerHTML='';
    pag.style.display=pages>1?'':'none';
    for(var i=1;i<=pages;i++){
      var b=document.createElement('button');
      b.className='page-btn'+(i===page?' active':'');
      b.textContent=i;
      b.dataset.page=i;
      pag.appendChild(b);
    }
    if(page<pages){
      var n=document.createElement('button');
      n.className='page-btn wide';
      n.textContent=pag.dataset.older;
      n.dataset.page=page+1;
      pag.appendChild(n);
    }
  }
  pag.addEventListener('click',function(e){
    var p=e.target.dataset&&e.target.dataset.page;
    if(!p)return;
    page=+p;render();
    document.querySelector('.featured-section').scrollIntoView({behavior:'smooth'});
  });
  tabs.forEach(function(tab){
    tab.addEventListener('click',function(){
      tabs.forEach(function(t){t.classList.remove('active');});
      this.classList.add('active');
      cat=this.dataset.filter;page=1;render();
    });
  });
  render();
})();
</script>
<SiteScripts />
  </Fragment>
</BaseLayout>
