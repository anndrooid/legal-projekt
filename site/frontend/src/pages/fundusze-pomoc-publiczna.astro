---
import BaseLayout from "../layouts/BaseLayout.astro";
import PracticeTeam from "../components/PracticeTeam.astro";
import "../styles/pages/fundusze-pomoc-publiczna.css";
---

<BaseLayout title="Fundusze i Pomoc Publiczna – ZMW Legal" active="/fundusze-pomoc-publiczna">
<div class="page-header">
  <div class="page-header-inner">
    <div>
      <a href="/" class="ph-back reveal">‹ Praktyki</a>
      <h1 class="ph-title">Fundusze i<br>Pomoc Publiczna</h1>
    </div>
    <div>
      <p class="ph-desc reveal reveal-d1">Pomagamy pozyskiwać fundusze publiczne – ze środków UE i krajowych – na projekty inwestycyjne i B+R. Obsługujemy cały cykl: od złożenia wniosku i rozliczenia środków po reprezentację w sporach z instytucjami.</p>
      <p class="ph-desc reveal reveal-d2" style="margin-top:1.5rem">Specjalizujemy się w kompleksowej obsłudze projektów – od złożenia wniosku i rozliczenia środków po reprezentację w postępowaniach kontrolnych.</p>
      <div class="ph-tags reveal reveal-d3">
        <span class="ph-tag">Fundusze UE</span>
        <span class="ph-tag">Dotacje B+R</span>
        <span class="ph-tag">Polska Strefa Inwestycji</span>
        <span class="ph-tag">Kontrole projektów</span>
        <span class="ph-tag">Ulgi podatkowe</span>
      </div>
    </div>
  </div>
</div>

<div class="services-section">
  <div class="wrap">
    <div class="row-between">
      <div>
        <span class="label">Zakres usług</span>
        <h2 class="h2-sec">Jak możemy<br>pomóc</h2>
      </div>
    </div>
    <div class="services-grid">

      <div class="service-card reveal">
        <div class="service-num">01</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg></div>
        <p class="service-title">Granty, dotacje, pożyczki</p>
        <p class="service-desc">Doradztwo w pozyskiwaniu grantów i dotacji ze środków krajowych i unijnych. Wsparcie przy aplikowaniu o preferencyjnie oprocentowane pożyczki na projekty inwestycyjne i B+R.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">02</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg></div>
        <p class="service-title">Ulgi i zwolnienia podatkowe</p>
        <p class="service-desc">Wsparcie w procesie uzyskiwania zwolnień i ulg podatkowych, w tym w ramach Polskiej Strefy Inwestycji. Analiza dostępnych instrumentów i optymalizacja ścieżki pozyskania zachęt.</p>
      </div>

      <div class="service-card reveal reveal-d2">
        <div class="service-num">03</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></div>
        <p class="service-title">Wejścia kapitałowe</p>
        <p class="service-desc">Obsługa uzyskiwania wejść kapitałowych podmiotów publicznych do spółek. Doradztwo w zakresie struktury transakcji, warunków umowy i zobowiązań wynikających z wsparcia publicznego.</p>
      </div>

      <div class="service-card reveal reveal-d3">
        <div class="service-num">04</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
        <p class="service-title">Kontrole projektów</p>
        <p class="service-desc">Asystowanie podczas kontroli u beneficjentów środków publicznych. Przygotowanie dokumentacji, wyjaśnień i odpowiedzi na zastrzeżenia pokontrolne. Minimalizacja ryzyka zwrotu środków.</p>
      </div>

      <div class="service-card reveal">
        <div class="service-num">05</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="3" x2="12" y2="21"/><line x1="9" y1="21" x2="15" y2="21"/><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="8" x2="1" y2="14"/><line x1="4" y1="8" x2="7" y2="14"/><path d="M1 14q3 4 6 0"/><line x1="20" y1="8" x2="17" y2="14"/><line x1="20" y1="8" x2="23" y2="14"/><path d="M17 14q3 4 6 0"/></svg></div>
        <p class="service-title">Postępowanie sporne</p>
        <p class="service-desc">Reprezentacja w sporach z organami przyznającymi środki finansowe i organami kontrolnymi. Odwołania, skargi do sądów administracyjnych i postępowania przed Komisją Europejską.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">06</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg></div>
        <p class="service-title">Rozliczanie przyznanych środków</p>
        <p class="service-desc">Konsultacje prawidłowości rozliczania i raportowania projektów dofinansowanych. Weryfikacja dokumentacji, kwalifikowalności wydatków i zgodności z wymogami instytucji pośredniczących.</p>
      </div>

    </div>
  </div>
</div>

<div class="stats-band">
  <div class="stats-band-inner">
    <div class="stats-header">
      <p class="stats-header-title">18 lat doświadczenia. Ponad 7 miliardów złotych pozyskanych dla klientów.</p>
    </div>
    <div class="stats-grid">
      <div class="stat-card reveal">
        <p class="stat-num">18+</p>
        <p class="stat-lbl">lat doświadczenia zespołu w doradztwie dotacyjnym</p>
        <p class="stat-note">Zespół z wieloletnim doświadczeniem w doradztwie dotacyjnym</p>
      </div>
      <div class="stat-card reveal reveal-d1">
        <p class="stat-num">4 mld zł</p>
        <p class="stat-lbl">dotacji pozyskanych dla klientów</p>
        <p class="stat-note">Granty krajowe i unijne, środki B+R, programy sektorowe</p>
      </div>
      <div class="stat-card reveal reveal-d2">
        <p class="stat-num">3,2 mld zł</p>
        <p class="stat-lbl">ulg podatkowych pozyskanych dla klientów</p>
        <p class="stat-note">Polska Strefa Inwestycji, ulgi B+R, zwolnienia strefowe</p>
      </div>
    </div>
  </div>
</div>

<div class="approach-band">
  <div class="wrap">
    <div class="approach-inner">
      <div>
        <span class="label">Nasze podejście</span>
        <h2 class="h2-sec">Kompleksowe podejście – od aplikacji<br>po obronę w postępowaniach.</h2>
        <p class="lead reveal" style="margin-top:2rem">Łączymy kompetencje prawne, technologiczne i finansowe w jeden zintegrowany model obsługi – od pozyskania środków przez rozliczenie aż po obronę w postępowaniach kontrolnych i spornych.</p>
      </div>
      <div>
        <p class="body-text reveal reveal-d1" style="margin-bottom:1.5rem">Nasz zespół obsługuje projekty we wszystkich etapach życia dotacji: identyfikacja możliwości, aplikowanie, realizacja i rozliczenie projektu, kontrole i postępowania sporne.</p>
        <p class="body-text reveal reveal-d2">Rozumiemy zarówno logikę instytucji zarządzających, jak i realia biznesowe beneficjentów. Dzięki temu jesteśmy w stanie przygotować dokumentację, która przechodzi przez kontrole, i skutecznie bronić klientów gdy coś pójdzie nie tak.</p>
      </div>
    </div>
  </div>
</div>

<div class="team-section">
  <div class="wrap">
    <div class="row-between" style="margin-bottom:4rem">
      <div>
        <span class="label">Nasz zespół</span>
        <h2 class="h2-sec">Prawnicy specjalizujący się<br>w Dotacjach i Grantach</h2>
      </div>
      <a href="/nasz-zespol" class="btn-row-link">
        Cały zespół
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
    <div class="team-grid-7">

      <PracticeTeam practice="fundusze-pomoc-publiczna" />

    </div>
  </div>
</div><div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label">Skontaktuj się z nami</span>
      <h2 class="kt-h2">Myślisz o pozyskaniu dotacji<br>lub ulgi podatkowej?</h2>
      <p class="kt-lead reveal reveal-d1">Rozmawiamy konkretnie i bez zbędnych formalności. Zadzwoń lub napisz – umawiamy spotkania stacjonarne i online.</p>
      <div class="btn-row reveal reveal-d2" style="justify-content:center">
        <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">+48 22 319 47 60</a>
        <a href="/kontakt" class="btn-s">Formularz kontaktowy</a>
      </div>
    </div>
  </div>
</div>

  <Fragment slot="scripts">
<script is:inline>
(function(){
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}
  document.documentElement.classList.add('js-ready');
  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){
            setTimeout(function(){li.classList.add('visible');},idx*110);
          });
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }
})();
</script>
  </Fragment>
</BaseLayout>
