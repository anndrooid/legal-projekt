---
import { PortableText } from "astro-portabletext";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonPhoto from "../../components/PersonPhoto.astro";
import SiteScripts from "../../components/SiteScripts.astro";
import ArticleBlock from "../../components/portable/ArticleBlock.astro";
import ArticleList from "../../components/portable/ArticleList.astro";
import ArticleQuote from "../../components/portable/ArticleQuote.astro";
import ArticleImage from "../../components/portable/ArticleImage.astro";
import { phone, practiceBySlug } from "../../data/site";
import { formatDate } from "../../utils";
import { bgStyle, urlFor } from "../../utils/image";
import { getArticle, getArticles } from "../../utils/sanity";
import "../../styles/pages/artykul.css";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((a) => ({ params: { slug: a.slug.current } }));
}

const { slug } = Astro.params;
const article = await getArticle(slug!);
if (!article) return Astro.redirect("/404");

const others = (await getArticles()).filter((a) => a._id !== article._id);
const more = others.slice(0, 3);
const related = (others.length > 3 ? others.slice(3, 6) : others).slice(0, 3);

const date = formatDate(article.publishedAt);
const people = (article.people ?? []).filter((p) => p.person);
const practice = practiceBySlug(article.practice);

const seoTitle = article.seo?.metaTitle || `${article.title} – Aktualności – ZMW Legal`;
const seoDescription = article.seo?.metaDescription || article.excerpt;
const ogSource = article.seo?.ogImage ?? article.cover;
const ogImage = ogSource?.asset ? urlFor(ogSource).width(1200).height(630).fit("crop").url() : undefined;

const components = {
  block: ArticleBlock,
  list: ArticleList,
  type: { quote: ArticleQuote, image: ArticleImage },
};
---

<BaseLayout title={seoTitle} description={seoDescription} image={ogImage} active="/aktualnosci">
<!-- ARTICLE HEADER -->
<div class="art-header">
  <div class="art-header-inner">
    <div>
      <a href="/aktualnosci" class="ph-back reveal">‹ Aktualności</a>
      <span class="art-cat-label reveal reveal-d1">{article.category} · {date}</span>
      <h1 class="art-title">{article.title}</h1>
    </div>
    <div class="art-right">
      <div class="art-meta-list">
        <div class="art-meta-row">
          <span class="art-meta-lbl">Kategoria</span>
          <span class="art-meta-val">{article.category}</span>
        </div>
        <div class="art-meta-row">
          <span class="art-meta-lbl">Data</span>
          <span class="art-meta-val">{date}</span>
        </div>
        {article.source && (
          <div class="art-meta-row">
            <span class="art-meta-lbl">Źródło</span>
            <span class="art-meta-val">{article.source}</span>
          </div>
        )}
        {people.length > 0 && (
          <div class="art-meta-row">
            <span class="art-meta-lbl">Wyróżnieni</span>
            <span class="art-meta-val">{people.map((p) => p.person!.name).join(", ")}</span>
          </div>
        )}
      </div>
      <p class="art-lead reveal reveal-d2">{article.excerpt}</p>
    </div>
  </div>
</div>

{article.cover?.asset && (
  <!-- HERO IMAGE -->
  <div class="art-hero-img reveal" style={bgStyle(article.cover, 1920)} role="img" aria-label={article.cover.alt || ""}></div>
)}

<!-- ARTICLE CONTENT -->
<div class="art-content">
  <div class="wrap">
    <div class="art-layout">

      <!-- MAIN ARTICLE -->
      <article class="art-body">
        {article.body?.length ? <PortableText value={article.body} components={components} /> : null}

        {article.tags?.length ? (
          <div class="art-tags reveal">
            {article.tags.map((t) => <span class="art-tag">{t}</span>)}
          </div>
        ) : null}

        <div class="art-share reveal">
          <span class="share-lbl">Udostępnij:</span>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} class="share-btn" target="_blank" rel="noopener">LinkedIn</a>
          <a href="#" class="share-btn" data-copy-link>Kopiuj link</a>
        </div>
      </article>

      <!-- SIDEBAR -->
      <aside class="art-sidebar">

        <div class="sidebar-section sidebar-cta reveal">
          <h3>Skontaktuj się</h3>
          <p style="font-size:.875rem;color:#666;line-height:1.6;margin-bottom:1.25rem">Potrzebujesz wsparcia prawnego? Nasi eksperci są do Twojej dyspozycji.</p>
          <a href={phone.href} class="btn-p" style="white-space:nowrap;width:100%;justify-content:center;font-size:.875rem;margin-bottom:.75rem">Zadzwoń: {phone.display}</a>
          <a href="/kontakt" class="btn-s" style="width:100%;justify-content:center;font-size:.875rem">Napisz do nas</a>
        </div>

        {people.length > 0 && (
          <div class="sidebar-section reveal reveal-d1">
            <h3>{article.category === "Wyróżnienia" || article.category === "Rankingi" ? "Wyróżnieni prawnicy" : "Prawnicy"}</h3>
            {people.map(({ person, note }, idx) => (
              <Fragment>
                {idx > 0 && <hr style="border:none;border-top:1px solid #f0f0f0;margin:1.25rem 0" />}
                <div class="sidebar-person">
                  <div class="person-photo"><PersonPhoto image={person!.photo} alt={person!.name} sizes="80px" /></div>
                  <div>
                    <p class="person-name">{person!.name}</p>
                    <p class="person-role">{note ? `${person!.role} · ${note}` : person!.role}</p>
                  </div>
                </div>
                <a href={`/zespol/${person!.slug.current}`} class="sidebar-link">
                  Zobacz profil <span class="btn-c btn-c-sm" style="display:inline-flex"><span class="arr"></span></span>
                </a>
              </Fragment>
            ))}
          </div>
        )}

        {practice && (
          <div class="sidebar-section reveal reveal-d2">
            <h3>Praktyka</h3>
            <p style="font-size:.875rem;color:#666;line-height:1.65;margin-bottom:1rem">{practice.desc}</p>
            <a href={practice.href} class="btn-row-link" style="font-size:.85rem;gap:.5rem">
              Dowiedz się więcej <span class="btn-c btn-c-sm" style="display:inline-flex"><span class="arr"></span></span>
            </a>
          </div>
        )}

        {related.length > 0 && (
          <div class="sidebar-section reveal reveal-d3">
            <h3>Pozostałe aktualności</h3>
            <div class="related-list">
              {related.map((r) => (
                <a href={`/aktualnosci/${r.slug.current}`} class="related-item">
                  <span class="related-cat">{r.category}</span>
                  <span class="related-title">{r.title}</span>
                  <span class="related-date">{formatDate(r.publishedAt)}</span>
                </a>
              ))}
            </div>
            <a href="/aktualnosci" class="btn-row-link" style="font-size:.85rem;margin-top:1.5rem;gap:.5rem">
              Wszystkie aktualności <span class="btn-c btn-c-sm" style="display:inline-flex"><span class="arr"></span></span>
            </a>
          </div>
        )}

      </aside>
    </div>
  </div>
</div>

{more.length > 0 && (
  <!-- MORE ARTICLES -->
  <div class="more-section">
    <div class="wrap">
      <div class="row-between">
        <div>
          <span class="label">Aktualności</span>
          <h2 class="h2-sec">Więcej<br>z kancelarii</h2>
        </div>
        <a href="/aktualnosci" class="btn-row-link">
          Wszystkie aktualności
          <span class="btn-c"><span class="arr"></span></span>
        </a>
      </div>
      <div class="more-grid">
        {more.map((m, idx) => (
          <a href={`/aktualnosci/${m.slug.current}`} class:list={["more-card reveal", idx === 1 && "reveal-d1", idx === 2 && "reveal-d2"]}>
            <div class="more-img" style={m.cover?.asset ? bgStyle(m.cover, 800) : undefined}></div>
            <span class="more-cat">{m.category}</span>
            <p class="more-title">{m.title}</p>
            <span class="more-date">{formatDate(m.publishedAt)}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
)}

<!-- CTA przed stopką -->
<section style="background:var(--navy);padding:5rem 0">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:3rem;flex-wrap:wrap">
    <div>
      <span class="label reveal" style="color:rgba(255,255,255,.5)">Masz sprawę prawną?</span>
      <h2 class="reveal reveal-d1" style="font-size:clamp(1.75rem,3vw,2.75rem);font-weight:500;color:#fff;letter-spacing:-.03em;line-height:1.1;margin-bottom:.75rem">Porozmawiajmy o Twojej sytuacji.</h2>
      <p class="reveal reveal-d2" style="font-size:1rem;color:rgba(255,255,255,.6);line-height:1.7">Umawiamy spotkania stacjonarne i online. Najszybszy kontakt: telefon.</p>
    </div>
    <div class="art-cta-btns reveal reveal-d2" style="display:flex;gap:1rem;flex-wrap:wrap;flex-shrink:0">
      <a href={phone.href} class="btn-p" style="white-space:nowrap">Zadzwoń: {phone.display}</a>
      <a href="/kontakt" class="btn-s" style="color:rgba(255,255,255,.7);border-color:rgba(255,255,255,.25);background:transparent">Napisz do nas</a>
    </div>
  </div>
</section>

  <Fragment slot="scripts">
<script is:inline>
document.querySelectorAll('[data-copy-link]').forEach(function(el){
  el.addEventListener('click',function(e){
    e.preventDefault();
    if(navigator.clipboard){navigator.clipboard.writeText(location.href).then(function(){el.textContent='Skopiowano';setTimeout(function(){el.textContent='Kopiuj link';},2000);});}
  });
});
</script>
<SiteScripts />
  </Fragment>
</BaseLayout>
