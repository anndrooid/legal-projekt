---
import ArticlePage from "../../views/ArticlePage.astro";
import { getArticle, getArticles } from "../../utils/sanity";

export async function getStaticPaths() {
  const articles = await getArticles("pl");
  return articles.map((a) => ({ params: { slug: a.slug.current } }));
}

const article = await getArticle(Astro.params.slug!, "pl");
if (!article) return Astro.redirect("/404");
---

<ArticlePage lang="pl" article={article} />
