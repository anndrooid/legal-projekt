---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/polityka-prywatnosci.css";
---

<BaseLayout title="Polityka prywatności – ZMW Legal">
<!-- PAGE HEADER -->
<div class="page-header">
  <div class="page-header-inner">
    <div class="ph-left">
      <a href="/" class="ph-back">‹ Strona główna</a>
      <h1 class="ph-title">Polityka<br>prywatności</h1>
    </div>
    <div class="ph-right">
      <p class="ph-desc">Informacje o tym, jak przetwarzamy dane osobowe – kto jest administratorem, w jakim celu i na jakiej podstawie prawnej zbieramy dane oraz jakie przysługują Ci prawa.</p>
      <p class="ph-meta">Wersja obowiązująca od 1 stycznia 2024 r.</p>
    </div>
  </div>
</div>

<!-- PRIVACY POLICY -->
<div class="privacy-section">
  <div class="wrap">
    <div class="privacy-layout">

      <!-- SIDEBAR NAV -->
      <nav class="privacy-nav" aria-label="Spis treści">
        <p class="privacy-nav-label">Spis treści</p>
        <ul class="privacy-nav-list">
          <li class="privacy-nav-item active"><a href="#s1">Administrator danych</a></li>
          <li class="privacy-nav-item"><a href="#s2">Skąd mamy Twoje dane</a></li>
          <li class="privacy-nav-item"><a href="#s3">Cele i podstawy przetwarzania</a></li>
          <li class="privacy-nav-item"><a href="#s4">Okres przechowywania</a></li>
          <li class="privacy-nav-item"><a href="#s5">Odbiorcy danych</a></li>
          <li class="privacy-nav-item"><a href="#s6">Twoje prawa</a></li>
          <li class="privacy-nav-item"><a href="#s7">Pliki cookie</a></li>
          <li class="privacy-nav-item"><a href="#s8">Zmiany polityki</a></li>
          <li class="privacy-nav-item"><a href="#s9">Kontakt</a></li>
        </ul>
      </nav>

      <!-- CONTENT -->
      <div class="privacy-content">

        <div class="privacy-block" id="s1">
          <span class="privacy-block-label">01</span>
          <h2>Administrator danych osobowych</h2>
          <p>Administratorem Twoich danych osobowych jest <strong>ZAWADZKA MROWIEC &amp; WSPÓLNICY SP. K.</strong> z siedzibą w Warszawie, ul. Wspólna 47A (III p.), 00-684 Warszawa, wpisana do Krajowego Rejestru Sądowego prowadzonego przez Sąd Rejonowy dla m.st. Warszawy w Warszawie, XII Wydział Gospodarczy KRS.</p>
          <p>We wszelkich sprawach dotyczących ochrony danych osobowych możesz skontaktować się z nami:</p>
          <ul>
            <li>e-mail: <a href="mailto:biuro@zmwlegal.pl" style="white-space:nowrap">biuro@zmwlegal.pl</a></li>
            <li>telefon: <a href="tel:+48223194760" style="white-space:nowrap">+48 22 319 47 60</a> (pon.–pt., 9:30–17:30)</li>
            <li>adres korespondencyjny: ul. Wspólna 47A, 00-684 Warszawa</li>
          </ul>
        </div>

        <div class="privacy-block" id="s2">
          <span class="privacy-block-label">02</span>
          <h2>Skąd mamy Twoje dane</h2>
          <p>Przetwarzamy dane osobowe, które:</p>
          <ul>
            <li><strong>Przekazujesz nam bezpośrednio</strong> – wypełniając formularz kontaktowy na stronie, wysyłając wiadomość e-mail, dzwoniąc do kancelarii lub spotykając się z naszymi prawnikami.</li>
            <li><strong>Zbieramy automatycznie</strong> – podczas odwiedzin strony internetowej, za pośrednictwem plików cookie i podobnych technologii (adres IP, typ przeglądarki, strony odwiedzone, czas wizyty).</li>
            <li><strong>Otrzymujemy od osób trzecich</strong> – w ramach prowadzonych spraw sądowych i transakcji, od klientów kancelarii wskazujących nas jako pełnomocnika lub doradcę.</li>
          </ul>
        </div>

        <div class="privacy-block" id="s3">
          <span class="privacy-block-label">03</span>
          <h2>Cele i podstawy przetwarzania danych</h2>
          <p>Przetwarzamy dane osobowe w następujących celach i na następujących podstawach prawnych:</p>

          <table class="data-table">
            <thead>
              <tr>
                <th>Cel przetwarzania</th>
                <th>Podstawa prawna (RODO)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Odpowiedź na zapytania przesłane przez formularz kontaktowy lub e-mail</td>
                <td>Art. 6 ust. 1 lit. f – prawnie uzasadniony interes administratora (udzielenie odpowiedzi na korespondencję)</td>
              </tr>
              <tr>
                <td>Zawarcie i realizacja umowy o świadczenie pomocy prawnej</td>
                <td>Art. 6 ust. 1 lit. b – niezbędność do wykonania umowy lub podjęcia działań przed jej zawarciem</td>
              </tr>
              <tr>
                <td>Wypełnienie obowiązków wynikających z przepisów prawa (m.in. ustawa o radcach prawnych, ustawa o adwokaturze, przepisy AML)</td>
                <td>Art. 6 ust. 1 lit. c – obowiązek prawny ciążący na administratorze</td>
              </tr>
              <tr>
                <td>Dochodzenie lub obrona roszczeń</td>
                <td>Art. 6 ust. 1 lit. f – prawnie uzasadniony interes administratora</td>
              </tr>
              <tr>
                <td>Analityka strony internetowej i poprawa jej funkcjonowania</td>
                <td>Art. 6 ust. 1 lit. f – prawnie uzasadniony interes administratora; lub art. 6 ust. 1 lit. a – zgoda (dla cookies analitycznych)</td>
              </tr>
              <tr>
                <td>Przesyłanie newslettera i informacji o działalności kancelarii</td>
                <td>Art. 6 ust. 1 lit. a – zgoda osoby, której dane dotyczą</td>
              </tr>
            </tbody>
          </table>

          <p>Podanie danych osobowych jest dobrowolne, jednak niepodanie danych niezbędnych do realizacji usługi uniemożliwia jej świadczenie.</p>
        </div>

        <div class="privacy-block" id="s4">
          <span class="privacy-block-label">04</span>
          <h2>Okres przechowywania danych</h2>
          <p>Dane osobowe przechowujemy przez okres niezbędny do realizacji celów, dla których zostały zebrane:</p>
          <ul>
            <li><strong>Dane z formularza kontaktowego</strong> – do czasu udzielenia odpowiedzi i przez 12 miesięcy od ostatniego kontaktu, chyba że nawiązana zostanie współpraca.</li>
            <li><strong>Dane związane z umową o świadczenie pomocy prawnej</strong> – przez czas trwania umowy oraz przez 10 lat od jej zakończenia (termin przedawnienia roszczeń).</li>
            <li><strong>Dane przetwarzane na podstawie obowiązku prawnego</strong> (m.in. AML) – przez okresy wskazane w przepisach szczególnych, nie krócej niż 5 lat.</li>
            <li><strong>Dane z plików cookie analitycznych</strong> – przez okres wskazany w polityce cookies, maksymalnie 26 miesięcy.</li>
            <li><strong>Dane przetwarzane na podstawie zgody</strong> – do czasu wycofania zgody.</li>
          </ul>
          <p>Po upływie wskazanych okresów dane są usuwane lub anonimizowane.</p>
        </div>

        <div class="privacy-block" id="s5">
          <span class="privacy-block-label">05</span>
          <h2>Odbiorcy danych osobowych</h2>
          <p>Twoje dane osobowe mogą być przekazywane następującym kategoriom odbiorców:</p>
          <ul>
            <li><strong>Podmioty świadczące usługi na rzecz kancelarii</strong> – dostawcy systemów informatycznych, operatorzy poczty elektronicznej, firmy obsługujące hosting strony internetowej, dostawcy usług księgowych – wyłącznie na podstawie stosownych umów powierzenia przetwarzania danych.</li>
            <li><strong>Organy publiczne</strong> – sądy, organy administracji, organy ścigania – wyłącznie na podstawie obowiązujących przepisów prawa.</li>
            <li><strong>Prawnicy i doradcy</strong> – współpracujące kancelarie lub eksperci zewnętrzni zaangażowani w prowadzenie konkretnej sprawy, wyłącznie w zakresie niezbędnym do jej realizacji.</li>
          </ul>
          <p>Dane co do zasady nie są przekazywane poza Europejski Obszar Gospodarczy. W przypadku korzystania z narzędzi dostawców działających poza EOG (np. Google Analytics) stosujemy standardowe klauzule umowne zatwierdzone przez Komisję Europejską.</p>
        </div>

        <div class="privacy-block" id="s6">
          <span class="privacy-block-label">06</span>
          <h2>Twoje prawa</h2>
          <p>Na podstawie przepisów RODO przysługują Ci następujące prawa:</p>
          <ul>
            <li><strong>Prawo dostępu</strong> – możesz uzyskać informację, czy i jakie dane przetwarzamy, oraz otrzymać kopię tych danych.</li>
            <li><strong>Prawo do sprostowania</strong> – możesz żądać poprawienia nieprawidłowych lub uzupełnienia niekompletnych danych.</li>
            <li><strong>Prawo do usunięcia</strong> – możesz żądać usunięcia danych w przypadkach wskazanych w art. 17 RODO (m.in. gdy dane nie są już niezbędne do celów, dla których zostały zebrane).</li>
            <li><strong>Prawo do ograniczenia przetwarzania</strong> – możesz żądać ograniczenia przetwarzania danych w przypadkach wskazanych w art. 18 RODO.</li>
            <li><strong>Prawo do przenoszenia danych</strong> – możesz otrzymać dane w ustrukturyzowanym formacie nadającym się do odczytu maszynowego.</li>
            <li><strong>Prawo do sprzeciwu</strong> – możesz wnieść sprzeciw wobec przetwarzania opartego na prawnie uzasadnionym interesie administratora.</li>
            <li><strong>Prawo do wycofania zgody</strong> – jeżeli przetwarzanie odbywa się na podstawie zgody, możesz ją wycofać w dowolnym momencie bez wpływu na zgodność z prawem przetwarzania przed jej wycofaniem.</li>
          </ul>
          <p>Aby skorzystać z powyższych praw, skontaktuj się z nami pod adresem <a href="mailto:biuro@zmwlegal.pl" style="white-space:nowrap">biuro@zmwlegal.pl</a>. Na Twoje żądanie odpowiemy bez zbędnej zwłoki, nie później niż w ciągu 30 dni.</p>
          <p>Masz również prawo wniesienia skargi do organu nadzorczego – <strong>Prezesa Urzędu Ochrony Danych Osobowych</strong> (ul. Stawki 2, 00-193 Warszawa, <a href="https://uodo.gov.pl" target="_blank" rel="noopener">uodo.gov.pl</a>), jeżeli uważasz, że przetwarzanie Twoich danych narusza przepisy RODO.</p>
        </div>

        <div class="privacy-block" id="s7">
          <span class="privacy-block-label">07</span>
          <h2>Pliki cookie i dane techniczne</h2>
          <p>Nasza strona internetowa używa plików cookie – małych plików tekstowych zapisywanych na Twoim urządzeniu. Stosujemy trzy kategorie plików cookie:</p>
          <ul>
            <li><strong>Niezbędne</strong> – wymagane do prawidłowego działania strony (np. zapamiętanie preferencji dotyczących cookies). Nie wymagają zgody.</li>
            <li><strong>Analityczne</strong> – pozwalają nam mierzyć ruch na stronie i poprawiać jej funkcjonowanie (Google Analytics). Wymagają Twojej zgody.</li>
            <li><strong>Marketingowe</strong> – służą do personalizacji treści i reklam. Wymagają Twojej zgody.</li>
          </ul>
          <p>Możesz zarządzać preferencjami dotyczącymi plików cookie w każdej chwili za pomocą panelu ustawień cookies dostępnego na naszej stronie lub poprzez ustawienia przeglądarki internetowej. Wyłączenie plików cookie może wpłynąć na funkcjonowanie niektórych elementów strony.</p>
          <p>Zbieramy również dane techniczne generowane automatycznie przy odwiedzinach strony: adres IP, typ i wersję przeglądarki, system operacyjny, referrer URL. Dane te służą wyłącznie celom statystycznym i bezpieczeństwa.</p>
        </div>

        <div class="privacy-block" id="s8">
          <span class="privacy-block-label">08</span>
          <h2>Zmiany polityki prywatności</h2>
          <p>Zastrzegamy sobie prawo do zmiany niniejszej polityki prywatności – w szczególności w przypadku zmian przepisów prawa, zmian w zakresie świadczonych usług lub zmian stosowanych technologii.</p>
          <p>O istotnych zmianach poinformujemy poprzez zamieszczenie zaktualizowanej wersji na stronie internetowej z nową datą obowiązywania. Zachęcamy do regularnego zapoznawania się z treścią polityki.</p>
        </div>

        <div class="privacy-block" id="s9">
          <span class="privacy-block-label">09</span>
          <h2>Kontakt w sprawach ochrony danych</h2>
          <p>We wszelkich sprawach związanych z przetwarzaniem danych osobowych oraz realizacją przysługujących Ci praw prosimy o kontakt:</p>
          <ul>
            <li><strong>E-mail:</strong> <a href="mailto:biuro@zmwlegal.pl" style="white-space:nowrap">biuro@zmwlegal.pl</a></li>
            <li><strong>Telefon:</strong> <a href="tel:+48223194760" style="white-space:nowrap">+48 22 319 47 60</a> (pon.–pt., 9:30–17:30)</li>
            <li><strong>Adres:</strong> ZAWADZKA MROWIEC &amp; WSPÓLNICY SP. K., ul. Wspólna 47A (III p.), 00-684 Warszawa</li>
          </ul>
          <p>Staramy się odpowiadać na wszystkie zapytania w ciągu jednego dnia roboczego.</p>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- CTA -->
<div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label">Skontaktuj się z nami</span>
      <h2 class="kt-h2">Pytania dotyczące<br>przetwarzania danych?</h2>
      <p class="kt-lead">Odpowiemy konkretnie i bez zbędnych formalności. Zadzwoń lub napisz.</p>
      <div class="btn-row" style="justify-content:center">
        <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">+48 22 319 47 60</a>
        <a href="/kontakt" class="btn-s">Formularz kontaktowy</a>
      </div>
    </div>
  </div>
</div>

<!-- FOOTER -->

  <Fragment slot="scripts">
<script is:inline>
(function(){
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}

  // Active sidebar nav on scroll
  var sections=document.querySelectorAll('.privacy-block[id]');
  var navItems=document.querySelectorAll('.privacy-nav-item');
  function onScroll(){
    var scrollY=window.scrollY+160;
    var current='';
    sections.forEach(function(s){if(scrollY>=s.offsetTop)current=s.id;});
    navItems.forEach(function(item){
      var link=item.querySelector('a');
      item.classList.toggle('active',link&&link.getAttribute('href')==='#'+current);
    });
  }
  window.addEventListener('scroll',onScroll,{passive:true});
  onScroll();
  document.documentElement.classList.add('js-ready');
  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){setTimeout(function(){li.classList.add('visible');},idx*110);});
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }
})();
</script>
  </Fragment>
</BaseLayout>
