---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/home.css";
import "../styles/team.css";
import PersonPhoto from "../components/PersonPhoto.astro";
import { formatDate } from "../utils";
import { bgStyle } from "../utils/image";
import { getArticles, getPeople } from "../utils/sanity";

const team = (await getPeople()).slice(0, 4);
const news = (await getArticles()).slice(0, 3);
const delay = (idx: number) => ["", "reveal-d1", "reveal-d2", "reveal-d3"][idx % 4];
---

<BaseLayout title="Strona główna – ZMW Legal">
<!-- HERO -->
<a href="/" class="hero-logo-anim" id="heroLogoAnim" aria-label="LEGAL"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 138 52" aria-hidden="true"><text x="69" y="40" text-anchor="middle" font-family="PPNeueMontreal,sans-serif" font-weight="500" font-size="36" letter-spacing="1">LEGAL</text></svg></a>
<div class="hero-pin-wrap" id="heroPinWrap">
  <div class="hero-screen">
    <div class="hero-intro-wrap">
      <div class="hero-intro-text" id="heroIntroText">
        <p>Wspieramy firmy i przedsi&#281;biorc&oacute;w w najbardziej wymagaj&#261;cych sporach i decyzjach biznesowych. &Lstrok;&#261;czymy mi&#281;dzynarodowe do&#347;wiadczenie z osobistym zaanga&#380;owaniem partnera w ka&#380;dej sprawie.</p>
      </div>
    </div>
  </div>
</div>

<!-- INTRO -->
<section class="intro sec-white" id="po-hero">
  <div class="wrap">
    <div class="intro-grid">
      <div>
        <span class="label reveal">Kancelaria prawna &middot; Warszawa</span>
        <h1 class="h1-hero reveal reveal-d1">Wygrywamy<br>trudne sprawy</h1>
      </div>
      <div style="padding-top:1rem" class="reveal reveal-d2">
        <p class="lead" style="max-width:580px;margin-bottom:2.5rem">Wspieramy firmy i przedsi&#281;biorc&oacute;w indywidualnie i konkretnie &ndash; jeste&#347;my gotowi w najbardziej wymagaj&#261;cych sprawach, niezale&#380;nie od ich skali i z&#322;o&#380;ono&#347;ci.</p>
        <div class="btn-row">
          <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">Zadzwo&#324;: +48 22 319 47 60</a>
          <a href="#kontakt" class="btn-row-link">
            Napisz do nas
            <span class="btn-c"><span class="arr"></span></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- RANKINGI -->
<div class="rankings-band">
  <div class="rankings-inner">
    <span class="rank-lbl reveal">Wyr&oacute;&#380;nienia i rankingi</span>
    <div class="rank-logos">
      <div class="rank-logo rank-logo-txt"><span class="rank-pub-name">Chambers<br>Europe</span></div>
      <div class="rank-logo rank-logo-txt"><span class="rank-pub-name">Legal 500<br>EMEA</span></div>
      <div class="rank-logo rank-logo-txt"><span class="rank-pub-name">FT Innovative<br>Lawyers</span></div>
      <div class="rank-logo rank-logo-txt"><span class="rank-pub-name">Who's Who<br>Legal</span></div>
    </div>
  </div>
</div>

<!-- STATS -->
<div class="stats-band sec-warm">
  <div class="stats-inner">
    <div class="stat-cell reveal">
      <div class="stat-num" data-count="29">29</div>
      <div class="stat-lbl">specjalist&oacute;w &ndash; partnerzy, counselowie, associates i eksperci bran&#380;owi</div>
    </div>
    <div class="stat-cell reveal reveal-d1">
      <div class="stat-num" data-count="5">5</div>
      <div class="stat-lbl">obszar&oacute;w specjalizacji &ndash; spory, Life Sciences, fundusze, digital, podatki</div>
    </div>
    <div class="stat-cell reveal reveal-d2">
      <div class="stat-num" data-count="20" data-suffix="+">20+</div>
      <div class="stat-lbl">lat do&#347;wiadczenia lider&oacute;w praktyk &ndash; partnerzy z kancelarii mi&#281;dzynarodowych</div>
    </div>
    <div class="stat-cell reveal reveal-d3">
      <div class="stat-num" data-count="4" data-suffix=" mld">4 mld</div>
      <div class="stat-lbl">z&#322;otych dotacji i ulg pozyskanych przez praktyk&#281; Funduszy i Pomocy Publicznej</div>
    </div>
  </div>
</div>

<!-- PRAKTYKI -->
<section class="sec sec-white">
  <div class="wrap">
    <div class="row-between reveal">
      <div>
        <span class="label">Nasze praktyki</span>
        <h2 class="h2-sec">Pi&#281;&#263; obszar&oacute;w specjalizacji.<br>Jedno podej&#347;cie.</h2>
      </div>
      <a href="/faq" class="btn-row-link">
        Jak pracujemy? Sprawd&#378; FAQ
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
    <div class="prac-grid">
      <div class="prac-card reveal">
        <div class="prac-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="21"/><line x1="9" y1="21" x2="15" y2="21"/><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="7" x2="1" y2="13"/><line x1="4" y1="7" x2="7" y2="13"/><path d="M1 13Q4 17 7 13"/><line x1="20" y1="7" x2="17" y2="13"/><line x1="20" y1="7" x2="23" y2="13"/><path d="M17 13Q20 17 23 13"/></svg></div>
        <p class="prac-name">Rozwi&#261;zywanie Spor&oacute;w</p>
        <p class="prac-desc">Spory korporacyjne, arbitra&#380; i post&#281;powania s&#261;dowe. Reprezentacja przed s&#261;dami, trybuna&#322;ami i organami administracji.</p>
        <a href="/rozwiazywanie-sporow" class="btn-row-link" style="margin-top:auto;font-size:.85rem;gap:.55rem">
          Dowiedz si&#281; wi&#281;cej
          <span class="btn-c btn-c-sm"><span class="arr"></span></span>
        </a>
      </div>
      <div class="prac-card reveal reveal-d1">
        <div class="prac-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6"/><path d="M10 3v5L5 17a1 1 0 00.9 1.5h12.2a1 1 0 00.9-1.5L14 8V3"/><path d="M6.5 15h11"/></svg></div>
        <p class="prac-name">Life Sciences</p>
        <p class="prac-desc">Prawo farmaceutyczne i &#380;ywno&#347;ciowe &ndash; doradztwo regulacyjne, rejestracja produkt&oacute;w, audyty i post&#281;powania.</p>
        <a href="/life-sciences" class="btn-row-link" style="margin-top:auto;font-size:.85rem;gap:.55rem">
          Dowiedz si&#281; wi&#281;cej
          <span class="btn-c btn-c-sm"><span class="arr"></span></span>
        </a>
      </div>
      <div class="prac-card reveal reveal-d2">
        <div class="prac-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
        <p class="prac-name">Fundusze i Pomoc Publiczna</p>
        <p class="prac-desc">Ponad 4 mld z&#322; pozyskanych dotacji i ulg podatkowych. Obs&#322;uga kontroli i post&#281;powa&#324; spornych ze &#347;rodk&oacute;w publicznych.</p>
        <a href="/fundusze-pomoc-publiczna" class="btn-row-link" style="margin-top:auto;font-size:.85rem;gap:.55rem">
          Dowiedz si&#281; wi&#281;cej
          <span class="btn-c btn-c-sm"><span class="arr"></span></span>
        </a>
      </div>
      <div class="prac-card reveal reveal-d3">
        <div class="prac-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div>
        <p class="prac-name">Digital</p>
        <p class="prac-desc">Telekomunikacja, ochrona danych, AI i e-commerce. Wsparcie prawne dla sektora technologicznego, medi&oacute;w i nadawc&oacute;w.</p>
        <a href="/digital" class="btn-row-link" style="margin-top:auto;font-size:.85rem;gap:.55rem">
          Dowiedz si&#281; wi&#281;cej
          <span class="btn-c btn-c-sm"><span class="arr"></span></span>
        </a>
      </div>
      <div class="prac-card reveal reveal-d4" style="border-right:none">
        <div class="prac-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="13" y2="13"/><line x1="8" y1="16" x2="11" y2="16"/><circle cx="15.5" cy="16.5" r="2.5"/><line x1="19" y1="20" x2="17.27" y2="18.27"/></svg></div>
        <p class="prac-name">Spory Podatkowe</p>
        <p class="prac-desc">Post&#281;powania przed KAS, s&#261;dami administracyjnymi i TSUE. Strategia sporu, kontrole, odpowiedzialno&#347;&#263; zarz&#261;du.</p>
        <a href="/spory-podatkowe" class="btn-row-link" style="margin-top:auto;font-size:.85rem;gap:.55rem">
          Dowiedz si&#281; wi&#281;cej
          <span class="btn-c btn-c-sm"><span class="arr"></span></span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- PODEJŚCIE -->
<section class="sec sec-navy">
  <div class="wrap">
    <span class="label reveal">Jak pracujemy</span>
    <h2 class="h2-sec reveal reveal-d1" style="margin-bottom:4rem">
      Indywidualnie.<br>Konkretnie.<br>Z pe&#322;nym zaanga&#380;owaniem.
    </h2>
    <div class="approach-grid">
      <div class="reveal">
        <p class="step-num">Krok 01</p>
        <p class="step-title">Rozumiemy spraw&#281;</p>
        <p class="step-desc">Ka&#380;de post&#281;powanie zaczyna si&#281; od dok&#322;adnego zapoznania si&#281; z sytuacj&#261; klienta &ndash; faktami, celami i ryzykiem. Nie zak&#322;adamy niczego z g&oacute;ry.</p>
      </div>
      <div class="reveal reveal-d1">
        <p class="step-num">Krok 02</p>
        <p class="step-title">Budujemy strategi&#281;</p>
        <p class="step-desc">Proponujemy podej&#347;cie skrojone do konkretnej sprawy. Uwzgl&#281;dniamy ca&#322;o&#347;&#263; &ndash; prawn&#261;, biznesow&#261; i ludzk&#261; perspektyw&#281;.</p>
      </div>
      <div class="reveal reveal-d2">
        <p class="step-num">Krok 03</p>
        <p class="step-title">Partner prowadzi Twoj&#261; spraw&#281;</p>
        <p class="step-desc">W butikowej kancelarii partner jest bezpo&#347;rednio dost&#281;pny od pierwszego spotkania do ostatniej decyzji. Odpowiedzialno&#347;&#263; nie jest delegowana w d&oacute;&#322; hierarchii.</p>
      </div>
      <div class="reveal reveal-d3">
        <p class="step-num">Krok 04</p>
        <p class="step-title">Dzia&#322;amy, nie tylko radzimy</p>
        <p class="step-desc">Reprezentujemy, negocjujemy i podejmujemy decyzje razem z klientem. Jeste&#347;my gotowi w sprawach o ka&#380;dej skali i z&#322;o&#380;ono&#347;ci.</p>
      </div>
    </div>
    <div class="btn-row reveal" style="margin-top:4.5rem">
      <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">Zadzwo&#324;: +48 22 319 47 60</a>
      <a href="#kontakt" class="btn-row-link">
        Napisz do nas
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
  </div>
</section>

<!-- NASZ ZESPÓŁ -->
<section class="sec sec-warm">
  <div class="wrap">
    <div class="row-between reveal">
      <div>
        <span class="label">Nasz Zesp&oacute;&#322;</span>
        <h2 class="h2-sec">Prawnicy z do&#347;wiadczeniem<br>na ka&#380;dym szczeblu.</h2>
      </div>
    </div>
    <div class="team-grid">
      {team.map((p, idx) => (
        <div class={`team-card reveal ${delay(idx)}`}>
          <div class="team-photo"><PersonPhoto image={p.photo} alt={p.name} /></div>
          <div class="team-body">
            <p class="team-name">{p.name}</p>
            <p class="team-role">{p.role}</p>
            <p class="team-spec">{p.specialization || " "}</p>
            <a href={`/zespol/${p.slug.current}`} class="btn-row-link" style="font-size:.875rem;gap:.55rem">
              Zobacz profil
              <span class="btn-c btn-c-sm"><span class="arr"></span></span>
            </a>
          </div>
        </div>
      ))}
    </div>
    <div class="team-count-bar reveal">
      <p>Poznaj <strong>wszystkich 29 prawnik&oacute;w i specjalist&oacute;w</strong> kancelarii &ndash; partner&oacute;w, counsel&oacute;w, associates i ekspert&oacute;w bran&#380;owych.</p>
      <a href="/nasz-zespol" class="btn-row-link" style="flex-shrink:0;gap:.75rem">
        Nasz Zesp&oacute;&#322;
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
  </div>
</section>

<!-- AKTUALNOŚCI -->
<section class="sec sec-white">
  <div class="wrap">
    <div class="row-between reveal">
      <div>
        <span class="label">Aktualno&#347;ci</span>
        <h2 class="h2-sec">Co s&#322;ycha&#263;<br>w kancelarii.</h2>
      </div>
      <a href="/aktualnosci" class="btn-row-link">
        Wszystkie aktualno&#347;ci
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
    <div class="news-grid">
      {news.map((a, idx) => (
        <div class={`news-card reveal ${delay(idx)}`}>
          {a.cover?.asset && (
            <a href={`/aktualnosci/${a.slug.current}`} class="news-img" style={bgStyle(a.cover, 800)} role="img" aria-label={a.cover.alt || a.title}></a>
          )}
          <p class="news-date">{formatDate(a.publishedAt)}</p>
          <p class="news-title">{a.title}</p>
          <p class="news-exc">{a.excerpt}</p>
          <a href={`/aktualnosci/${a.slug.current}`} class="btn-row-link" style="font-size:.875rem;gap:.55rem;margin-top:auto">
            Czytaj więcej
            <span class="btn-c btn-c-sm"><span class="arr"></span></span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- KONTAKT -->
<section class="sec sec-navy" id="kontakt">
  <div class="wrap">
    <div class="kt-grid">
      <div class="reveal">
        <span class="label">Kontakt</span>
        <h2 class="kt-h2">Porozmawiajmy<br>o Twojej sprawie.</h2>
        <p class="kt-lead">Zapraszamy na spotkania stacjonarne lub online &ndash; wy&#322;&#261;cznie po wcze&#347;niejszym um&oacute;wieniu terminu. Najszybszy kontakt: telefon.</p>
        <div class="kt-rows">
          <div><span class="kt-lbl">Telefon</span><a href="tel:+48223194760" class="kt-val" style="white-space:nowrap">+48 22 319 47 60</a></div>
          <div><span class="kt-lbl">E-mail</span><a href="mailto:biuro@zmwlegal.pl" class="kt-val" style="white-space:nowrap">biuro@zmwlegal.pl</a></div>
          <div><span class="kt-lbl">Adres</span><span class="kt-val">ul. Wspólna 47A (III p.), 00-684 Warszawa</span></div>
          <div><span class="kt-lbl">Godziny pracy</span><span class="kt-val">poniedzia&#322;ek &ndash; pi&#261;tek, 9:30&ndash;17:30</span></div>
        </div>
      </div>
      <form class="form reveal reveal-d1">
        <div class="form-field">
          <label for="a-imie">Imi&#281; i nazwisko</label>
          <input type="text" id="a-imie" placeholder="Jan Kowalski">
        </div>
        <div class="form-field">
          <label for="a-firma">Firma / organizacja <span style="font-weight:300;opacity:.6">(opcjonalnie)</span></label>
          <input type="text" id="a-firma" placeholder="Nazwa firmy">
        </div>
        <div class="form-field">
          <label for="a-email">Adres e-mail</label>
          <input type="email" id="a-email" placeholder="jan@firma.pl">
        </div>
        <div class="form-field">
          <label for="a-wiad">Tre&#347;&#263; wiadomo&#347;ci</label>
          <textarea id="a-wiad" placeholder="Opisz kr&oacute;tko spraw&#281; lub pytanie&hellip;"></textarea>
        </div>
        <p class="form-note">Przesy&#322;aj&#261;c formularz, wyra&#380;asz zgod&#281; na przetwarzanie danych osobowych przez ZAWADZKA MROWIEC &amp; WSP&Oacute;LNICY SP. K. w celu odpowiedzi na wiadomo&#347;&#263;.</p>
        <button type="submit" class="btn-p" style="align-self:flex-start">Wy&#347;lij wiadomo&#347;&#263;</button>
      </form>
    </div>
  </div>
</section>

  <Fragment slot="scripts">
<script is:inline>
(function(){
  document.documentElement.classList.add('js-ready');
  var nav=document.querySelector('nav.topnav');
  var hero=document.querySelector('.hero-screen');
  var heroPinWrap=document.getElementById('heroPinWrap');
  var heroRange=0;
  var animRange=0;
  var heroLogo=document.getElementById('heroLogoAnim');
  var heroLogoText=heroLogo?heroLogo.querySelector('svg text'):null;
  function updateNav(){
    var isSolid=window.scrollY>(heroRange||300);
    nav.classList.toggle('nav-solid',isSolid);
    // The hero logo stays pure white for as long as it sits over the photo; it turns navy
    // the instant the cream nav bar itself takes over (page truly scrolling) - no lag.
    if(heroLogoText)heroLogoText.style.fill=isSolid?'#1a2440':'#fff';
  }
  window.addEventListener('scroll',updateNav,{passive:true});
  window.addEventListener('resize',updateNav,{passive:true});
  updateNav();

  // Hero logo: large & centered on hero image, shrinks + docks into nav logo position on scroll.
  // The hero is pinned (sticky) for the duration of heroRange, so the page itself only starts
  // scrolling once the logo has docked and the intro text has settled.
  var navLogo=document.querySelector('.nav-logo-link');
  if(heroLogo&&navLogo&&hero&&heroPinWrap){
    var startBox,endBox;
    function lerp(a,b,t){return a+(b-a)*t;}
    function measure(){
      var vw=window.innerWidth,vh=Math.max(window.innerHeight,600);
      var w=Math.min(Math.max(vw*.34,280),620);
      startBox={width:w,left:(vw-w)/2,top:vh/2-(w*52/138)/2};
      var r=navLogo.getBoundingClientRect();
      endBox={width:r.width,left:r.left,top:r.top};
      heroRange=heroPinWrap.offsetHeight-hero.offsetHeight;
      // The logo/text animation finishes a bit before the pin actually releases, so there's a
      // brief "dead zone" (logo already docked, page still pinned) before the page starts
      // moving down. On touch a swipe covers far less distance than a mouse-wheel tick, so the
      // whole pinned range is already shortened (see the max-width:1024px media query) - keep
      // that dead zone equally tight there so it doesn't reintroduce an "extra scroll" feel.
      var isMobile=window.innerWidth<=1024;
      animRange=isMobile?Math.max(heroRange-60,heroRange*.75):Math.max(heroRange-180,heroRange*.5);
      updateHeroLogo();
      updateNav();
      heroLogo.style.opacity='1';
    }
    function updateHeroLogo(){
      if(!startBox||!endBox)return;
      var p=Math.min(Math.max(window.scrollY/animRange,0),1);
      var pY=1-(1-p)*(1-p);
      var pX=p*p;
      heroLogo.style.width=lerp(startBox.width,endBox.width,pY)+'px';
      heroLogo.style.left=lerp(startBox.left,endBox.left,pX)+'px';
      heroLogo.style.top=lerp(startBox.top,endBox.top,pY)+'px';
    }
    window.addEventListener('scroll',updateHeroLogo,{passive:true});
    window.addEventListener('resize',measure,{passive:true});
    if(document.fonts&&document.fonts.ready){document.fonts.ready.then(measure);}else{measure();}
    measure();
  }

  // Hero intro paragraph: slides up from below, tied 1:1 to scroll for a smooth, fluid feel
  // (not a threshold fade). Its own progress starts later than the logo's, so the two never
  // cross paths / crowd each other on screen.
  var introText=document.getElementById('heroIntroText');
  if(introText){
    function updateIntroText(){
      var p=animRange?Math.min(Math.max(window.scrollY/animRange,0),1):0;
      var delay=window.innerWidth<=1024?.25:.4;
      var tp=Math.min(Math.max((p-delay)/(1-delay),0),1);
      var te=1-(1-tp)*(1-tp);
      // hero-intro-wrap sits at the vertical center (top:50%), so a translateY of ~42% of
      // the viewport height starts the text right near the bottom edge of the hero photo.
      var vh=Math.max(window.innerHeight,600);
      var startOffset=vh*.42;
      introText.style.opacity=te;
      introText.style.transform='translateY('+((1-te)*startOffset)+'px)';
    }
    window.addEventListener('scroll',updateIntroText,{passive:true});
    window.addEventListener('resize',updateIntroText,{passive:true});
    updateIntroText();
  }

  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden'});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow=''});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open')});}

  // Line-by-line heading reveal
  var noMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver && !noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){
            setTimeout(function(){li.classList.add('visible');},idx*110);
          });
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h1-hero,.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(h){
      var _segs=h.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      h.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      h.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      h.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      h.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3','reveal-d4');
      hio.observe(h);
    });
  }

  // Scroll reveal
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }

  // Stat counter
  function animateCount(el){
    var target=parseInt(el.dataset.count,10);
    var suffix=el.dataset.suffix||'';
    var dur=1400,start=null;
    function tick(ts){
      if(!start)start=ts;
      var p=Math.min((ts-start)/dur,1);
      var ease=1-Math.pow(1-p,3);
      el.textContent=Math.round(ease*target)+suffix;
      if(p<1)requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  var statBand=document.querySelector('.stats-band');
  if(statBand&&window.IntersectionObserver){
    var sio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          document.querySelectorAll('.stat-num[data-count]').forEach(animateCount);
          sio.disconnect();
        }
      });
    },{threshold:0.3});
    sio.observe(statBand);
  }
})();
</script>
  </Fragment>
</BaseLayout>
