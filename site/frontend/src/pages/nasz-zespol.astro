---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/nasz-zespol.css";
import PersonPhoto from "../components/PersonPhoto.astro";
import { getPeople } from "../utils/sanity";
import { personCount, tiers } from "../data/site";

const people = await getPeople();
const groups = tiers
  .map((t) => ({ ...t, people: people.filter((p) => p.tier === t.value) }))
  .filter((g) => g.people.length > 0);
---

<BaseLayout title="Nasz Zespół – ZMW Legal" active="/nasz-zespol">
<!-- =====================
     PAGE HEADER – Ligit style
     ===================== -->
<div class="page-header">
  <div class="page-header-inner">

    <!-- Lewa kolumna: powrót + tytuł (bez border-left, jak Ligit) -->
    <div class="ph-left">
      <a href="/" class="ph-back reveal">
        <span class="ph-back-arrow">‹</span>
        Powrót do strony głównej
      </a>
      <h1 class="ph-title">Nasz Zespół</h1>
    </div>

    <!-- Prawa kolumna: opis wyrównany do góry -->
    <div class="ph-right">
      <p class="ph-desc reveal reveal-d1">29 prawników – partnerzy z doświadczeniem z kancelarii międzynarodowych, counselowie i associates o wąskich specjalizacjach. Każdy klient jest obsługiwany przez prawnika, który zna jego branżę i rozumie stawkę.</p>
    </div>

  </div>
</div>

<!-- FILTER BAR -->
<div class="filter-wrap reveal">
  <div class="filter-inner">
    <span class="filter-lbl">Filtruj:</span>
    <button class="filter-tab active" onclick="filterTeam('all',this)">Wszyscy ({people.length})</button>
    {groups.map((g) => <button class="filter-tab" onclick={`filterTeam('${g.value}',this)`}>{g.label}</button>)}
  </div>
</div>

<!-- TEAM GRID -->
<div class="team-section">
  <div class="team-grid show-all" id="teamGrid">
    {groups.map((g) => (
      <Fragment>
        <div class="team-tier-header reveal" data-tier-header={g.value}>
          <span class="team-tier-label">{g.label}</span>
          <span class="team-tier-count">{personCount(g.people.length)}</span>
        </div>
        {g.people.map((p) => (
          <div class="team-card" data-tier={g.value}>
            <div class="team-photo"><PersonPhoto image={p.photo} alt={p.name} /></div>
            <div class="team-body">
              <p class="team-name">{p.name}</p>
              <p class="team-role">{p.role}</p>
              <p class="team-spec">{p.specialization || " "}</p>
              <a href={`/zespol/${p.slug.current}`} class="btn-row-link" style="font-size:.85rem;gap:.5rem">
                Zobacz profil <span class="btn-c btn-c-sm"><span class="arr"></span></span>
              </a>
            </div>
          </div>
        ))}
      </Fragment>
    ))}
  </div><!-- /team-grid -->
</div><!-- /team-section -->

<!-- CTA KONTAKT – prosta wersja (jak w oryginalnym nasz-zespol) -->
<div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label reveal" style="text-align:center">Kontakt</span>
      <h2 class="kt-h2">Porozmawiajmy<br>o Twojej sprawie.</h2>
      <p class="kt-lead reveal reveal-d1">Najszybszy kontakt: telefon. Zapraszamy na spotkania stacjonarne lub online – wyłącznie po wcześniejszym umówieniu terminu.</p>
      <div class="btn-row reveal reveal-d2" style="justify-content:center">
        <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">Zadzwoń: +48 22 319 47 60</a>
        <a href="/#kontakt" class="btn-s">Formularz kontaktowy</a>
      </div>
    </div>
  </div>
</div>

  <Fragment slot="scripts">
<script is:inline>
function filterTeam(tier, btn) {
  document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');

  document.querySelectorAll('.team-card').forEach(function(card) {
    var show = tier === 'all' || card.dataset.tier === tier;
    card.style.display = show ? '' : 'none';
  });

  document.getElementById('teamGrid').classList.toggle('show-all', tier === 'all');
  document.querySelectorAll('.team-tier-header').forEach(function(hdr) {
    var show = tier === 'all' || hdr.dataset.tierHeader === tier;
    hdr.style.display = show ? '' : 'none';
  });
}
</script>
<script is:inline>
(function(){
  document.documentElement.classList.add('js-ready');
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}

  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;

  // Line-by-line heading reveal
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){
            setTimeout(function(){li.classList.add('visible');},idx*110);
          });
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }

  // Scroll reveal (static .reveal elements)
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }

  // Team cards — stagger per row (idx % 4), inline styles to avoid flash
  if(window.IntersectionObserver&&!noMotion){
    var tio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.classList.add('tc-vis');
          e.target.addEventListener('transitionend',function(){this.style.transitionDelay='';},{once:true});
          tio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.team-card').forEach(function(card){
      var leftFrac=Math.max(0,card.getBoundingClientRect().left)/window.innerWidth;
      card.style.transitionDelay=(leftFrac*0.25).toFixed(2)+'s';
      tio.observe(card);
    });
  }
})();
</script>
  </Fragment>
</BaseLayout>
