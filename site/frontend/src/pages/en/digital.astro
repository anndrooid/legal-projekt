---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PracticeTeam from "../../components/PracticeTeam.astro";
import "../../styles/pages/digital.css";
---

<BaseLayout title="Digital – ZMW Legal" active="/en/digital" lang="en" alternate="/digital">
<div class="page-header">
  <div class="page-header-inner">
    <div>
      <a href="/en" class="ph-back reveal">‹ Practices</a>
      <h1 class="ph-title">Digital</h1>
    </div>
    <div>
      <p class="ph-desc reveal reveal-d1">Legal advice for businesses in telecommunications, data protection, media, e-commerce and artificial intelligence.</p>
      <p class="ph-desc reveal reveal-d2" style="margin-top:1.5rem">We combine legal expertise with a practical understanding of technology, media and telecoms – supporting clients at every stage of building and launching digital products.</p>
      <div class="ph-tags reveal reveal-d3">
        <span class="ph-tag">Media and film</span>
        <span class="ph-tag">Telecommunications</span>
        <span class="ph-tag">E-commerce</span>
        <span class="ph-tag">Artificial intelligence</span>
        <span class="ph-tag">Data protection</span>
      </div>
    </div>
  </div>
</div>

<div class="services-section">
  <div class="wrap">
    <div class="row-between">
      <div>
        <span class="label">Our services</span>
        <h2 class="h2-sec">How we can<br>help</h2>
      </div>
    </div>
    <div class="services-grid-2">

      <div class="service-card reveal">
        <div class="service-num">01</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="7" y2="7"/><line x1="17" y1="7" x2="22" y2="7"/><line x1="2" y1="17" x2="7" y2="17"/><line x1="17" y1="17" x2="22" y2="17"/></svg></div>
        <p class="service-title">Media and film</p>
        <p class="service-desc">Legal advice for media businesses – managing copyright and intellectual property in domestic and international productions. Experience on Oscar-winning productions: “The Zone of Interest” and “A Real Pain”.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">02</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1.42 9a16 16 0 0121.16 0"/><path d="M5 12.55a11 11 0 0114.08 0"/><path d="M10.54 16.1a6 6 0 012.92 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></div>
        <p class="service-title">Telecoms and technology</p>
        <p class="service-desc">Advice for technology and telecoms companies on compliance with EU and international law. Intellectual property, new technologies, artificial intelligence and the AI Act.</p>
      </div>

      <div class="service-card reveal reveal-d2">
        <div class="service-num">03</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg></div>
        <p class="service-title">E-commerce platforms</p>
        <p class="service-desc">Advice for e-commerce platforms operating in domestic and international markets. Product compliance analysis across multiple jurisdictions – consumer, product, commercial and information law.</p>
      </div>

      <div class="service-card reveal reveal-d3">
        <div class="service-num">04</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></div>
        <p class="service-title">Broadcasters, operators and IT companies</p>
        <p class="service-desc">Support for digital transformation: implementing innovative technologies, radio frequency allocation, broadband infrastructure investments, and coordination with regulators and public authorities.</p>
      </div>

    </div>
  </div>
</div>

<div class="approach-band">
  <div class="wrap">
    <div class="approach-inner">
      <div>
        <span class="label">Our experience</span>
        <h2 class="h2-sec">Law for the digital sector –<br>from the film studio to the AI regulator.</h2>
        <p class="lead reveal" style="margin-top:2rem">Our experience includes Oscar-winning film productions, telecoms regulation, GDPR compliance and AI Act advice for businesses deploying artificial intelligence systems.</p>
      </div>
      <div>
        <div class="approach-list">
          <div class="approach-item reveal">
            <div class="approach-item-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
            <div class="approach-item-text">
              <p class="approach-item-title">More than 15 years in Digital</p>
              <p class="approach-item-desc">The head of the practice has specialised in media, technology, telecoms and digital services for more than 15 years.</p>
            </div>
          </div>
          <div class="approach-item reveal reveal-d1">
            <div class="approach-item-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
            <div class="approach-item-text">
              <p class="approach-item-title">World-class film productions</p>
              <p class="approach-item-desc">Experience on Oscar-winning productions – “The Zone of Interest” and “A Real Pain”.</p>
            </div>
          </div>
          <div class="approach-item reveal reveal-d2">
            <div class="approach-item-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg></div>
            <div class="approach-item-text">
              <p class="approach-item-title">AI regulation and new technologies</p>
              <p class="approach-item-desc">We advise on the AI Act, the GDPR and EU digital regulation – from compliance to disputes with authorities.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="team-section">
  <div class="wrap">
    <div class="row-between" style="margin-bottom:4rem">
      <div>
        <span class="label">Our team</span>
        <h2 class="h2-sec">Lawyers specialising<br>in Digital</h2>
      </div>
      <a href="/en/our-team" class="btn-row-link">
        Whole team
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
    <!-- Praktyka Digital – mały, wyspecjalizowany zespół -->
    <p style="max-width:640px;font-size:1rem;color:#666;line-height:1.75;margin-bottom:3rem">A boutique team with deep expertise in digital regulation – telecoms, data protection, the AI Act, e-commerce and media law. We work with operators, broadcasters, tech and e-commerce companies.</p>

    <div class="team-grid-2p">

      <PracticeTeam lang="en" practice="digital" />

    </div>
  </div>
</div><div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label">Contact us</span>
      <h2 class="kt-h2">Questions about digital law,<br>media or telecoms?</h2>
      <p class="kt-lead reveal reveal-d1">We talk to the point, without unnecessary formalities. Call or write – we arrange meetings in person and online.</p>
      <div class="btn-row reveal reveal-d2" style="justify-content:center">
        <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">+48 22 319 47 60</a>
        <a href="/en/contact" class="btn-s">Contact form</a>
      </div>
    </div>
  </div>
</div>

  <Fragment slot="scripts">
<script is:inline>
(function(){
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}
  document.documentElement.classList.add('js-ready');
  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){
            setTimeout(function(){li.classList.add('visible');},idx*110);
          });
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }
})();
</script>
  </Fragment>
</BaseLayout>
