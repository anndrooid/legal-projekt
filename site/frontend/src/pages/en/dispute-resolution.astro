---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PracticeTeam from "../../components/PracticeTeam.astro";
import "../../styles/pages/rozwiazywanie-sporow.css";
---

<BaseLayout title="Dispute resolution and arbitration | ZMW Legal" description="Corporate disputes, arbitration and litigation. We represent companies before courts, arbitral tribunals and administrative authorities in Poland." active="/en/dispute-resolution" lang="en" alternate="/rozwiazywanie-sporow">
<!-- PAGE HEADER -->
<div class="page-header">
  <div class="page-header-inner">
    <div class="ph-left">
      <a href="/en" class="ph-back reveal">‹ Practices</a>
      <h1 class="ph-title">Dispute<br>Resolution</h1>
    </div>
    <div class="ph-right">
      <p class="ph-desc reveal reveal-d1">We support our clients at every stage of a dispute. We represent them effectively before arbitral tribunals, common courts and public administration authorities.</p>
      <p class="ph-desc reveal reveal-d2" style="margin-top:1.5rem">Our practice goes beyond the courtroom – it covers day-to-day risk analysis, strategic advice and support for in-house legal teams.</p>
      <div class="ph-tags reveal reveal-d3">
        <span class="ph-tag">Corporate disputes</span>
        <span class="ph-tag">Arbitration</span>
        <span class="ph-tag">Common courts</span>
        <span class="ph-tag">Administrative proceedings</span>
      </div>
    </div>
  </div>
</div>

<!-- SERVICES -->
<div class="services-section">
  <div class="wrap">
    <div class="row-between">
      <div>
        <span class="label">Our services</span>
        <h2 class="h2-sec">What we do</h2>
      </div>
    </div>
    <div class="services-grid">

      <div class="service-card reveal">
        <div class="service-num">01</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="3" x2="12" y2="21"/><line x1="9" y1="21" x2="15" y2="21"/><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="8" x2="1" y2="14"/><line x1="4" y1="8" x2="7" y2="14"/><path d="M1 14q3 4 6 0"/><line x1="20" y1="8" x2="17" y2="14"/><line x1="20" y1="8" x2="23" y2="14"/><path d="M17 14q3 4 6 0"/></svg></div>
        <p class="service-title">Strategy</p>
        <p class="service-desc">We build tailored litigation strategies designed to maximise the chances of a favourable outcome while keeping the cost and duration of the dispute to a minimum.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">02</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 9 12 3 21 9"/><path d="M3 9v12h18V9"/><line x1="7" y1="13" x2="7" y2="21"/><line x1="12" y1="13" x2="12" y2="21"/><line x1="17" y1="13" x2="17" y2="21"/></svg></div>
        <p class="service-title">Representation</p>
        <p class="service-desc">We represent clients before common courts of all instances, arbitral tribunals (domestic and international), state administration authorities and regulators.</p>
      </div>

      <div class="service-card reveal reveal-d2">
        <div class="service-num">03</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <p class="service-title">Risk management</p>
        <p class="service-desc">We advise in-house legal and compliance teams on identifying, assessing and managing the legal risks of their business, and help put in place processes that reduce the risk of future disputes.</p>
      </div>

      <div class="service-card reveal reveal-d3">
        <div class="service-num">04</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
        <p class="service-title">Interim relief</p>
        <p class="service-desc">We advise and represent clients in interim relief proceedings before or during litigation. We act quickly and effectively – securing a claim often determines the actual outcome of a dispute.</p>
      </div>

      <div class="service-card reveal">
        <div class="service-num">05</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="10" y1="14" x2="3" y2="21"/><line x1="21" y1="3" x2="14" y2="10"/></svg></div>
        <p class="service-title">Preventing escalation</p>
        <p class="service-desc">We develop risk management strategies that reduce organisational, employment and contractual risks. Effective de-escalation – negotiation, mediation and settlement – is often a better solution than lengthy litigation.</p>
      </div>

    </div>
  </div>
</div>

<!-- APPROACH / OPIS PRAKTYKI -->
<div class="approach-band">
  <div class="wrap">
    <div class="approach-inner">
      <div>
        <span class="label">Our approach</span>
        <h2 class="h2-sec">Corporate disputes, arbitration<br>and administrative proceedings.</h2>
        <div class="approach-stat">
          <div class="stat-item">
            <div class="stat-num">20+</div>
            <div class="stat-lbl">years of experience<br>in disputes</div>
          </div>
          <div class="stat-item">
            <div class="stat-num">Band 1</div>
            <div class="stat-lbl">Legal 500 EMEA<br>Dispute Resolution</div>
          </div>
        </div>
      </div>
      <div>
        <p class="lead reveal" style="margin-bottom:2rem">Our experience covers complex commercial and regulatory disputes, including proceedings involving shareholders, company bodies and investors – also in a cross-border context.</p>
        <p class="body-text reveal reveal-d1" style="margin-bottom:1.5rem">We combine analytical precision with assertive, effective representation. We understand that for our clients a dispute is not just a legal issue – it is a real business risk that calls for strategic thinking from day one.</p>
        <p class="body-text reveal reveal-d2">Every case gets its own strategy. We assess the chances and risks honestly – advising not only when it is worth fighting, but also when it is worth settling.</p>
      </div>
    </div>
  </div>
</div>

<!-- RANKINGS & QUOTES -->
<div class="rankings-section">
  <div class="rankings-inner">
    <div class="rankings-header">
      <h2 class="rankings-title">What independent<br>rankings say about us</h2>
    </div>
    <div class="quotes-grid">

      <div class="quote-card reveal">
        <p class="quote-source">Legal 500 EMEA · Dispute Resolution</p>
        <p class="quote-text">“The team stands out for its litigation skills combined with strong business understanding and effective cooperation. It handles complex, precedent-setting cases with innovative solutions.”</p>
        <p class="quote-about">About ZMW Legal</p>
      </div>

      <div class="quote-card reveal reveal-d1">
        <p class="quote-source">Legal 500 EMEA · Dispute Resolution</p>
        <p class="quote-text">“Highly qualified Partners and Associates who combine experience from international law firms with the flexibility of a boutique.”</p>
        <p class="quote-about">About ZMW Legal</p>
      </div>

      <div class="quote-card reveal reveal-d2">
        <p class="quote-source">Chambers & Partners · Prof. Anna Zawadzka</p>
        <p class="quote-text">“In-depth analysis of the problem and a wide range of options and courses of action. Clients are impressed by the strategic approach from the very planning stage of a dispute.”</p>
        <p class="quote-about">Managing Partner · Band 1</p>
      </div>

      <div class="quote-card reveal reveal-d3">
        <p class="quote-source">Chambers & Partners · Piotr Mrowiec</p>
        <p class="quote-text">“Clients value the depth of expertise, proactive involvement and all-round approach. Unique experience in multi-million disputes before domestic and international forums.”</p>
        <p class="quote-about">Partner · Band 2</p>
      </div>

    </div>
  </div>
</div>

<!-- TEAM -->
<div class="team-section">
  <div class="wrap">
    <div class="row-between" style="margin-bottom:4rem">
      <div>
        <span class="label">Our team</span>
        <h2 class="h2-sec">Lawyers specialising<br>in Dispute Resolution</h2>
      </div>
      <a href="/en/our-team" class="btn-row-link">
        Whole team
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
    <div class="team-grid-prac">

      <PracticeTeam lang="en" practice="rozwiazywanie-sporow" />

    </div>
  </div>
</div>

<!-- CTA -->
<div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label">Contact us</span>
      <h2 class="kt-h2">Have a dispute<br>to resolve?</h2>
      <p class="kt-lead reveal reveal-d1">We talk to the point, without unnecessary formalities. Call or write – we arrange meetings in person and online.</p>
      <div class="btn-row reveal reveal-d2" style="justify-content:center">
        <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">+48 22 319 47 60</a>
        <a href="/en/contact" class="btn-s">Contact form</a>
      </div>
    </div>
  </div>
</div>

<!-- FOOTER -->

  <Fragment slot="scripts">
<script is:inline>
(function(){
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}
  document.documentElement.classList.add('js-ready');
  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){
            setTimeout(function(){li.classList.add('visible');},idx*110);
          });
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }
})();
</script>
  </Fragment>
</BaseLayout>
