---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PracticeTeam from "../../components/PracticeTeam.astro";
import "../../styles/pages/life-sciences.css";
---

<BaseLayout title="Pharmaceutical and food law – Life Sciences | ZMW Legal" description="Regulatory advice for the pharmaceutical and food sectors: product registration, GMP audits, dietary supplements, disputes and proceedings." active="/en/life-sciences" lang="en" alternate="/life-sciences">
<div class="page-header">
  <div class="page-header-inner">
    <div>
      <a href="/en" class="ph-back reveal">‹ Practices</a>
      <h1 class="ph-title">Life<br>Sciences</h1>
    </div>
    <div>
      <p class="ph-desc reveal reveal-d1">We translate complex pharmaceutical and food regulations into practical solutions. We support clients at every stage of their business – from planning and obtaining authorisations to certification and audits.</p>
      <p class="ph-desc reveal reveal-d2" style="margin-top:1.5rem">We identify potential risks and minimise them effectively – both in day-to-day operations and in crisis situations.</p>
      <div class="ph-tags reveal reveal-d3">
        <span class="ph-tag">Medicinal products</span>
        <span class="ph-tag">Dietary supplements</span>
        <span class="ph-tag">GMP audits</span>
        <span class="ph-tag">Product registration</span>
        <span class="ph-tag">Pharmaceutical law</span>
      </div>
    </div>
  </div>
</div>

<div class="services-section">
  <div class="wrap">
    <div class="row-between">
      <div>
        <span class="label">Our services</span>
        <h2 class="h2-sec">How we can<br>help</h2>
      </div>
    </div>
    <div class="services-grid">

      <div class="service-card reveal">
        <div class="service-num">01</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg></div>
        <p class="service-title">Strategic Advice</p>
        <p class="service-desc">Support in short- and long-term planning of business management and product development. Medicine distribution models in Poland and global markets, parallel importers in the EU, import of medicines for rare diseases.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">02</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="12" y2="17"/></svg></div>
        <p class="service-title">Legal Analyses and Opinions</p>
        <p class="service-desc">Detailed legislative analyses and reports on the practice of Polish regulators. Legal opinions that apply the regulations to specific facts and set out possible courses of action.</p>
      </div>

      <div class="service-card reveal reveal-d2">
        <div class="service-num">03</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6"/><path d="M10 3v5L5 17a1 1 0 00.9 1.5h12.2a1 1 0 00.9-1.5L14 8V3"/><path d="M6.5 15h11"/></svg></div>
        <p class="service-title">Medicinal Products</p>
        <p class="service-desc">Regulatory advice at every stage: research (R&D, clinical trials), registration procedures, placing on the market, post-authorisation variations and compliance monitoring. Support with product suspensions and withdrawals.</p>
      </div>

      <div class="service-card reveal reveal-d3">
        <div class="service-num">04</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><polyline points="9 12 11 14 15 10"/></svg></div>
        <p class="service-title">Audits</p>
        <p class="service-desc">Quality audits at pharmaceutical manufacturers and wholesalers assessing regulatory compliance. Carried out at the client’s premises or on its behalf at subcontractors and contract manufacturers – in Poland, the EU, Asia and North America.</p>
      </div>

      <div class="service-card reveal">
        <div class="service-num">05</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="3" x2="12" y2="21"/><line x1="9" y1="21" x2="15" y2="21"/><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="8" x2="1" y2="14"/><line x1="4" y1="8" x2="7" y2="14"/><path d="M1 14q3 4 6 0"/><line x1="20" y1="8" x2="17" y2="14"/><line x1="20" y1="8" x2="23" y2="14"/><path d="M17 14q3 4 6 0"/></svg></div>
        <p class="service-title">Legal Proceedings</p>
        <p class="service-desc">Representing clients before administrative and common courts. Cases concerning regulated activities (authorisations, licences, post-authorisation proceedings, registration and reimbursement), customs, tax and environmental matters.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">06</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></div>
        <p class="service-title">Food and Dietary Supplements</p>
        <p class="service-desc">Support for businesses placing food or dietary supplements on the market. Dealing with regulators, reviewing product composition, labelling and advertising, and proceedings before the sanitary inspection authorities.</p>
      </div>

    </div>
  </div>
</div>

<div class="approach-band">
  <div class="wrap">
    <div class="approach-inner">
      <div>
        <span class="label">Our experience</span>
        <h2 class="h2-sec">Pharmaceutical and food law –<br>across the entire product life cycle.</h2>
        <p class="lead reveal" style="margin-top:2rem">We advise at every stage – from R&D and clinical trials, through registration and distribution, to crisis situations and contentious proceedings.</p>
      </div>
      <div>
        <div class="approach-list">
          <div class="approach-item reveal">
            <div class="approach-item-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg></div>
            <div class="approach-item-text">
              <p class="approach-item-title">Audits on 4 continents</p>
              <p class="approach-item-desc">Experience in GMP audits in Poland, EU countries, Asia and North America.</p>
            </div>
          </div>
          <div class="approach-item reveal reveal-d1">
            <div class="approach-item-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg></div>
            <div class="approach-item-text">
              <p class="approach-item-title">The full regulatory cycle</p>
              <p class="approach-item-desc">From R&D and clinical trials, through registration and distribution, to post-authorisation variations and product withdrawal.</p>
            </div>
          </div>
          <div class="approach-item reveal reveal-d2">
            <div class="approach-item-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></div>
            <div class="approach-item-text">
              <p class="approach-item-title">Across the market</p>
              <p class="approach-item-desc">We work with manufacturers, parallel importers, wholesalers, distributors and marketing authorisation holders.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="team-section">
  <div class="wrap">
    <div class="row-between" style="margin-bottom:4rem">
      <div>
        <span class="label">Our team</span>
        <h2 class="h2-sec">Lawyers specialising<br>in Life Sciences</h2>
      </div>
      <a href="/en/our-team" class="btn-row-link">
        Whole team
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
    <div class="team-grid-prac">

      <PracticeTeam lang="en" practice="life-sciences" />

    </div>
  </div>
</div><div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label">Contact us</span>
      <h2 class="kt-h2">Questions about pharmaceutical<br>or food regulations?</h2>
      <p class="kt-lead reveal reveal-d1">We talk to the point, without unnecessary formalities. Call or write – we arrange meetings in person and online.</p>
      <div class="btn-row reveal reveal-d2" style="justify-content:center">
        <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">+48 22 319 47 60</a>
        <a href="/en/contact" class="btn-s">Contact form</a>
      </div>
    </div>
  </div>
</div>

  <Fragment slot="scripts">
<script is:inline>
(function(){
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}
  document.documentElement.classList.add('js-ready');
  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){
            setTimeout(function(){li.classList.add('visible');},idx*110);
          });
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }
})();
</script>
  </Fragment>
</BaseLayout>
