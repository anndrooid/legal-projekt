---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/pages/polityka-prywatnosci.css";
---

<BaseLayout title="Privacy Policy – ZMW Legal" lang="en" alternate="/polityka-prywatnosci">
<!-- PAGE HEADER -->
<div class="page-header">
  <div class="page-header-inner">
    <div class="ph-left">
      <a href="/en" class="ph-back">‹ Home</a>
      <h1 class="ph-title">Privacy<br>Policy</h1>
    </div>
    <div class="ph-right">
      <p class="ph-desc">How we process personal data – who the controller is, why and on what legal basis we collect data, and what rights you have.</p>
      <p class="ph-meta">Version effective from 1 January 2024.</p>
    </div>
  </div>
</div>

<!-- PRIVACY POLICY -->
<div class="privacy-section">
  <div class="wrap">
    <div class="privacy-layout">

      <!-- SIDEBAR NAV -->
      <nav class="privacy-nav" aria-label="Contents">
        <p class="privacy-nav-label">Contents</p>
        <ul class="privacy-nav-list">
          <li class="privacy-nav-item active"><a href="#s1">Data controller</a></li>
          <li class="privacy-nav-item"><a href="#s2">Where we get your data</a></li>
          <li class="privacy-nav-item"><a href="#s3">Purposes and legal bases</a></li>
          <li class="privacy-nav-item"><a href="#s4">Retention period</a></li>
          <li class="privacy-nav-item"><a href="#s5">Data recipients</a></li>
          <li class="privacy-nav-item"><a href="#s6">Your rights</a></li>
          <li class="privacy-nav-item"><a href="#s7">Cookies</a></li>
          <li class="privacy-nav-item"><a href="#s8">Policy changes</a></li>
          <li class="privacy-nav-item"><a href="#s9">Contact</a></li>
        </ul>
      </nav>

      <!-- CONTENT -->
      <div class="privacy-content">

        <div class="privacy-block" id="s1">
          <span class="privacy-block-label">01</span>
          <h2>Personal data controller</h2>
          <p>The controller of your personal data is <strong>ZAWADZKA MROWIEC & WSPÓLNICY SP. K.</strong> with its registered office in Warsaw, ul. Wspólna 47A (3rd floor), 00-684 Warsaw, entered in the National Court Register maintained by the District Court for the Capital City of Warsaw, 12th Commercial Division of the National Court Register.</p>
          <p>For any matters concerning personal data protection, you can contact us:</p>
          <ul>
            <li>e-mail: <a href="mailto:biuro@zmwlegal.pl" style="white-space:nowrap">biuro@zmwlegal.pl</a></li>
            <li>phone: <a href="tel:+48223194760" style="white-space:nowrap">+48 22 319 47 60</a> (Mon–Fri, 9:30–17:30)</li>
            <li>postal address: ul. Wspólna 47A, 00-684 Warsaw, Poland</li>
          </ul>
        </div>

        <div class="privacy-block" id="s2">
          <span class="privacy-block-label">02</span>
          <h2>Where we get your data</h2>
          <p>We process personal data that:</p>
          <ul>
            <li><strong>You provide to us directly</strong> – by completing the contact form on the website, sending an e-mail, calling the firm or meeting our lawyers.</li>
            <li><strong>We collect automatically</strong> – when you visit the website, through cookies and similar technologies (IP address, browser type, pages visited, time of visit).</li>
            <li><strong>We receive from third parties</strong> – in the course of court cases and transactions, from the firm’s clients who appoint us as their attorney or adviser.</li>
          </ul>
        </div>

        <div class="privacy-block" id="s3">
          <span class="privacy-block-label">03</span>
          <h2>Purposes and legal bases of processing</h2>
          <p>We process personal data for the following purposes and on the following legal bases:</p>

          <table class="data-table">
            <thead>
              <tr>
                <th>Purpose of processing</th>
                <th>Legal basis (GDPR)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Responding to enquiries sent via the contact form or by e-mail</td>
                <td>Art. 6(1)(f) – the controller’s legitimate interest (responding to correspondence)</td>
              </tr>
              <tr>
                <td>Concluding and performing a contract for legal services</td>
                <td>Art. 6(1)(b) – necessary for the performance of a contract or to take steps prior to entering into it</td>
              </tr>
              <tr>
                <td>Compliance with legal obligations (including the Attorneys-at-Law Act, the Advocates Act and AML regulations)</td>
                <td>Art. 6(1)(c) – a legal obligation to which the controller is subject</td>
              </tr>
              <tr>
                <td>Establishing, pursuing or defending claims</td>
                <td>Art. 6(1)(f) – the controller’s legitimate interest</td>
              </tr>
              <tr>
                <td>Website analytics and improving how the website works</td>
                <td>Art. 6(1)(f) – the controller’s legitimate interest; or Art. 6(1)(a) – consent (for analytics cookies)</td>
              </tr>
              <tr>
                <td>Sending the newsletter and information about the firm’s activities</td>
                <td>Art. 6(1)(a) – consent of the data subject</td>
              </tr>
            </tbody>
          </table>

          <p>Providing personal data is voluntary; however, without the data necessary to provide a service, we cannot provide it.</p>
        </div>

        <div class="privacy-block" id="s4">
          <span class="privacy-block-label">04</span>
          <h2>Data retention period</h2>
          <p>We store personal data for as long as necessary to achieve the purposes for which it was collected:</p>
          <ul>
            <li><strong>Contact form data</strong> – until we have responded and for 12 months after the last contact, unless we start working together.</li>
            <li><strong>Data related to a legal services contract</strong> – for the term of the contract and for 10 years after it ends (the limitation period for claims).</li>
            <li><strong>Data processed under a legal obligation</strong> (including AML) – for the periods specified in the relevant regulations, but not less than 5 years.</li>
            <li><strong>Analytics cookie data</strong> – for the period indicated in the cookie policy, up to 26 months.</li>
            <li><strong>Data processed on the basis of consent</strong> – until consent is withdrawn.</li>
          </ul>
          <p>After these periods, the data is deleted or anonymised.</p>
        </div>

        <div class="privacy-block" id="s5">
          <span class="privacy-block-label">05</span>
          <h2>Recipients of personal data</h2>
          <p>Your personal data may be disclosed to the following categories of recipients:</p>
          <ul>
            <li><strong>Service providers to the firm</strong> – IT system providers, e-mail operators, website hosting companies and accounting service providers – solely under appropriate data processing agreements.</li>
            <li><strong>Public authorities</strong> – courts, administrative authorities and law enforcement agencies – solely on the basis of applicable law.</li>
            <li><strong>Lawyers and advisers</strong> – cooperating law firms or external experts involved in a specific case, only to the extent necessary for that case.</li>
          </ul>
          <p>As a rule, data is not transferred outside the European Economic Area. Where we use tools from providers operating outside the EEA (e.g. Google Analytics), we apply standard contractual clauses approved by the European Commission.</p>
        </div>

        <div class="privacy-block" id="s6">
          <span class="privacy-block-label">06</span>
          <h2>Your rights</h2>
          <p>Under the GDPR you have the following rights:</p>
          <ul>
            <li><strong>Right of access</strong> – you can find out whether and what data we process and obtain a copy of it.</li>
            <li><strong>Right to rectification</strong> – you can request that inaccurate data be corrected or incomplete data be completed.</li>
            <li><strong>Right to erasure</strong> – you can request erasure of your data in the cases set out in Art. 17 GDPR (e.g. where the data is no longer necessary for the purposes for which it was collected).</li>
            <li><strong>Right to restriction of processing</strong> – you can request restriction of processing in the cases set out in Art. 18 GDPR.</li>
            <li><strong>Right to data portability</strong> – you can receive your data in a structured, machine-readable format.</li>
            <li><strong>Right to object</strong> – you can object to processing based on the controller’s legitimate interest.</li>
            <li><strong>Right to withdraw consent</strong> – where processing is based on consent, you can withdraw it at any time without affecting the lawfulness of processing before its withdrawal.</li>
          </ul>
          <p>To exercise these rights, contact us at <a href="mailto:biuro@zmwlegal.pl" style="white-space:nowrap">biuro@zmwlegal.pl</a>. We will respond to your request without undue delay and in any event within 30 days.</p>
          <p>You also have the right to lodge a complaint with the supervisory authority – <strong>the President of the Personal Data Protection Office</strong> (ul. Stawki 2, 00-193 Warsaw, <a href="https://uodo.gov.pl" target="_blank" rel="noopener">uodo.gov.pl</a>) if you believe that the processing of your data infringes the GDPR.</p>
        </div>

        <div class="privacy-block" id="s7">
          <span class="privacy-block-label">07</span>
          <h2>Cookies and technical data</h2>
          <p>Our website uses cookies – small text files stored on your device. We use three categories of cookies:</p>
          <ul>
            <li><strong>Necessary</strong> – required for the website to work properly. The only such cookie is <code>zmw_consent</code>, which stores your cookie choice (kept for 12 months). They do not require consent.</li>
            <li><strong>Analytics</strong> – statistics tools (e.g. Google Analytics) that let us measure traffic and improve the website. We only run them after you have given your consent.</li>
            <li><strong>Marketing</strong> – used to tailor content and messages to your interests. We only run them after you have given your consent.</li>
          </ul>
          <p>On your first visit we show a banner where you can accept all categories, reject all except the necessary ones, or choose them individually in the settings. You can change your choice at any time by clicking the <a href="#" data-cookie-settings>Cookie settings</a> link (also available in the footer of every page), or delete cookies in your browser settings. Withdrawing consent does not affect the lawfulness of processing carried out before its withdrawal.</p>
          <p>We also collect technical data generated automatically when you visit the website: IP address, browser type and version, operating system and referrer URL. This data is used solely for statistical and security purposes.</p>
        </div>

        <div class="privacy-block" id="s8">
          <span class="privacy-block-label">08</span>
          <h2>Changes to this privacy policy</h2>
          <p>We reserve the right to change this privacy policy – in particular in the event of changes in the law, in the services we provide or in the technologies we use.</p>
          <p>We will announce significant changes by publishing an updated version on the website with a new effective date. We encourage you to review the policy regularly.</p>
        </div>

        <div class="privacy-block" id="s9">
          <span class="privacy-block-label">09</span>
          <h2>Data protection contact</h2>
          <p>For any matters relating to the processing of personal data and the exercise of your rights, please contact us:</p>
          <ul>
            <li><strong>E-mail:</strong> <a href="mailto:biuro@zmwlegal.pl" style="white-space:nowrap">biuro@zmwlegal.pl</a></li>
            <li><strong>Phone:</strong> <a href="tel:+48223194760" style="white-space:nowrap">+48 22 319 47 60</a> (Mon–Fri, 9:30–17:30)</li>
            <li><strong>Address:</strong> ZAWADZKA MROWIEC & WSPÓLNICY SP. K., ul. Wspólna 47A (3rd floor), 00-684 Warsaw, Poland</li>
          </ul>
          <p>We aim to respond to all enquiries within one working day.</p>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- CTA -->
<div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label">Contact us</span>
      <h2 class="kt-h2">Questions about<br>data processing?</h2>
      <p class="kt-lead">We will answer to the point, without unnecessary formalities. Call or write.</p>
      <div class="btn-row" style="justify-content:center">
        <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">+48 22 319 47 60</a>
        <a href="/en/contact" class="btn-s">Contact form</a>
      </div>
    </div>
  </div>
</div>

<!-- FOOTER -->

  <Fragment slot="scripts">
<script is:inline>
(function(){
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}

  // Active sidebar nav on scroll
  var sections=document.querySelectorAll('.privacy-block[id]');
  var navItems=document.querySelectorAll('.privacy-nav-item');
  function onScroll(){
    var scrollY=window.scrollY+160;
    var current='';
    sections.forEach(function(s){if(scrollY>=s.offsetTop)current=s.id;});
    navItems.forEach(function(item){
      var link=item.querySelector('a');
      item.classList.toggle('active',link&&link.getAttribute('href')==='#'+current);
    });
  }
  window.addEventListener('scroll',onScroll,{passive:true});
  onScroll();
  document.documentElement.classList.add('js-ready');
  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){setTimeout(function(){li.classList.add('visible');},idx*110);});
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }
})();
</script>
  </Fragment>
</BaseLayout>
