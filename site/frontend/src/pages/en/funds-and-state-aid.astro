---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PracticeTeam from "../../components/PracticeTeam.astro";
import "../../styles/pages/fundusze-pomoc-publiczna.css";
---

<BaseLayout title="Funds & State Aid – ZMW Legal" active="/en/funds-and-state-aid" lang="en" alternate="/fundusze-pomoc-publiczna">
<div class="page-header">
  <div class="page-header-inner">
    <div>
      <a href="/en" class="ph-back reveal">‹ Practices</a>
      <h1 class="ph-title">Funds &<br>State Aid</h1>
    </div>
    <div>
      <p class="ph-desc reveal reveal-d1">We help businesses obtain public funding – from EU and national sources – for investment and R&D projects. We cover the whole cycle: from the application and settlement of funds to representation in disputes with institutions.</p>
      <p class="ph-desc reveal reveal-d2" style="margin-top:1.5rem">We support projects end to end – from the application and settlement of funds to representation in audit proceedings.</p>
      <div class="ph-tags reveal reveal-d3">
        <span class="ph-tag">EU funds</span>
        <span class="ph-tag">R&D grants</span>
        <span class="ph-tag">Polish Investment Zone</span>
        <span class="ph-tag">Project audits</span>
        <span class="ph-tag">Tax reliefs</span>
      </div>
    </div>
  </div>
</div>

<div class="services-section">
  <div class="wrap">
    <div class="row-between">
      <div>
        <span class="label">Our services</span>
        <h2 class="h2-sec">How we can<br>help</h2>
      </div>
    </div>
    <div class="services-grid">

      <div class="service-card reveal">
        <div class="service-num">01</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg></div>
        <p class="service-title">Grants, subsidies, loans</p>
        <p class="service-desc">Advice on obtaining grants and subsidies from national and EU funds. Support in applying for low-interest loans for investment and R&D projects.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">02</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg></div>
        <p class="service-title">Tax reliefs and exemptions</p>
        <p class="service-desc">Support in obtaining tax exemptions and reliefs, including under the Polish Investment Zone. Analysis of the available instruments and the best route to obtaining incentives.</p>
      </div>

      <div class="service-card reveal reveal-d2">
        <div class="service-num">03</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></div>
        <p class="service-title">Equity investments</p>
        <p class="service-desc">Support with equity investments by public entities in companies. Advice on the transaction structure, contract terms and obligations arising from public support.</p>
      </div>

      <div class="service-card reveal reveal-d3">
        <div class="service-num">04</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
        <p class="service-title">Project audits</p>
        <p class="service-desc">Assistance during audits of beneficiaries of public funds. Preparing documentation, explanations and responses to post-audit findings. Minimising the risk of having to repay funds.</p>
      </div>

      <div class="service-card reveal">
        <div class="service-num">05</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="3" x2="12" y2="21"/><line x1="9" y1="21" x2="15" y2="21"/><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="8" x2="1" y2="14"/><line x1="4" y1="8" x2="7" y2="14"/><path d="M1 14q3 4 6 0"/><line x1="20" y1="8" x2="17" y2="14"/><line x1="20" y1="8" x2="23" y2="14"/><path d="M17 14q3 4 6 0"/></svg></div>
        <p class="service-title">Disputes</p>
        <p class="service-desc">Representation in disputes with funding and audit authorities. Appeals, complaints to the administrative courts and proceedings before the European Commission.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">06</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg></div>
        <p class="service-title">Settlement of funds</p>
        <p class="service-desc">Advice on the correct settlement and reporting of funded projects. Review of documentation, eligibility of expenditure and compliance with the requirements of intermediate bodies.</p>
      </div>

    </div>
  </div>
</div>

<div class="stats-band">
  <div class="stats-band-inner">
    <div class="stats-header">
      <p class="stats-header-title">18 years of experience. More than PLN 7 billion obtained for clients.</p>
    </div>
    <div class="stats-grid">
      <div class="stat-card reveal">
        <p class="stat-num">18+</p>
        <p class="stat-lbl">years of the team’s experience in grant advisory</p>
        <p class="stat-note">A team with 18 years of experience in grant advisory</p>
      </div>
      <div class="stat-card reveal reveal-d1">
        <p class="stat-num">PLN 4 bn</p>
        <p class="stat-lbl">in grants obtained for clients</p>
        <p class="stat-note">National and EU grants, R&D funding, sector programmes</p>
      </div>
      <div class="stat-card reveal reveal-d2">
        <p class="stat-num">PLN 3.2 bn</p>
        <p class="stat-lbl">in tax reliefs obtained for clients</p>
        <p class="stat-note">Polish Investment Zone, R&D reliefs, zone exemptions</p>
      </div>
    </div>
  </div>
</div>

<div class="approach-band">
  <div class="wrap">
    <div class="approach-inner">
      <div>
        <span class="label">Our approach</span>
        <h2 class="h2-sec">End to end – from the application<br>to defence in proceedings.</h2>
        <p class="lead reveal" style="margin-top:2rem">We combine legal, technological and financial expertise in a single integrated model – from obtaining funds, through settlement, to defence in audit and contentious proceedings.</p>
      </div>
      <div>
        <p class="body-text reveal reveal-d1" style="margin-bottom:1.5rem">Our team supports projects at every stage of a grant’s life: identifying opportunities, applying, implementing and settling the project, audits and disputes.</p>
        <p class="body-text reveal reveal-d2">We understand both the logic of managing institutions and the business realities of beneficiaries. That is why we can prepare documentation that passes audits – and defend clients effectively when something goes wrong.</p>
      </div>
    </div>
  </div>
</div>

<div class="team-section">
  <div class="wrap">
    <div class="row-between" style="margin-bottom:4rem">
      <div>
        <span class="label">Our team</span>
        <h2 class="h2-sec">Lawyers specialising<br>in Grants and Subsidies</h2>
      </div>
      <a href="/en/our-team" class="btn-row-link">
        Whole team
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
    <div class="team-grid-7">

      <PracticeTeam lang="en" practice="fundusze-pomoc-publiczna" />

    </div>
  </div>
</div><div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label">Contact us</span>
      <h2 class="kt-h2">Thinking about a grant<br>or a tax relief?</h2>
      <p class="kt-lead reveal reveal-d1">We talk to the point, without unnecessary formalities. Call or write – we arrange meetings in person and online.</p>
      <div class="btn-row reveal reveal-d2" style="justify-content:center">
        <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">+48 22 319 47 60</a>
        <a href="/en/contact" class="btn-s">Contact form</a>
      </div>
    </div>
  </div>
</div>

  <Fragment slot="scripts">
<script is:inline>
(function(){
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}
  document.documentElement.classList.add('js-ready');
  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){
            setTimeout(function(){li.classList.add('visible');},idx*110);
          });
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }
})();
</script>
  </Fragment>
</BaseLayout>
