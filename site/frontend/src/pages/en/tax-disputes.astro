---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PracticeTeam from "../../components/PracticeTeam.astro";
import "../../styles/pages/spory-podatkowe.css";
---

<BaseLayout title="Tax Disputes – ZMW Legal" active="/en/tax-disputes" lang="en" alternate="/spory-podatkowe">
<div class="page-header">
  <div class="page-header-inner">
    <div>
      <a href="/en" class="ph-back reveal">‹ Practices</a>
      <h1 class="ph-title">Tax<br>Disputes</h1>
    </div>
    <div>
      <p class="ph-desc reveal reveal-d1">We support clients at every stage of tax audits, customs and tax audits and tax proceedings. Representation before the administrative courts, the National Revenue Administration, the Court of Justice of the EU and the European Commission.</p>
      <p class="ph-desc reveal reveal-d2" style="margin-top:1.5rem">We specialise in complex disputes with tax authorities – we look for unconventional solutions and have experience in landmark judgments of the Supreme Administrative Court, the Constitutional Tribunal and the CJEU.</p>
      <div class="ph-tags reveal reveal-d3">
        <span class="ph-tag">Tax audits</span>
        <span class="ph-tag">Revenue proceedings</span>
        <span class="ph-tag">Administrative courts</span>
        <span class="ph-tag">CJEU</span>
        <span class="ph-tag">Fiscal penal proceedings</span>
      </div>
    </div>
  </div>
</div>

<div class="services-section">
  <div class="wrap">
    <div class="row-between">
      <div>
        <span class="label">Our services</span>
        <h2 class="h2-sec">How we can<br>help</h2>
      </div>
    </div>
    <div class="services-grid">

      <div class="service-card reveal">
        <div class="service-num">01</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="3" x2="12" y2="21"/><line x1="9" y1="21" x2="15" y2="21"/><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="8" x2="1" y2="14"/><line x1="4" y1="8" x2="7" y2="14"/><path d="M1 14q3 4 6 0"/><line x1="20" y1="8" x2="17" y2="14"/><line x1="20" y1="8" x2="23" y2="14"/><path d="M17 14q3 4 6 0"/></svg></div>
        <p class="service-title">Dispute strategy</p>
        <p class="service-desc">We develop a strategy for your tax dispute – unconventional and tailored to your case. We have experience in cases that produced landmark judgments of the Supreme Administrative Court, the Constitutional Tribunal and the CJEU.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">02</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
        <p class="service-title">Tax audits</p>
        <p class="service-desc">Representation during verification activities, tax audits and customs and tax audits. We prepare you for the audit, assist during inspections and draft explanations and objections.</p>
      </div>

      <div class="service-card reveal reveal-d2">
        <div class="service-num">03</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 9 12 3 21 9"/><path d="M3 9v12h18V9"/><line x1="7" y1="13" x2="7" y2="21"/><line x1="12" y1="13" x2="12" y2="21"/><line x1="17" y1="13" x2="17" y2="21"/></svg></div>
        <p class="service-title">Tax proceedings</p>
        <p class="service-desc">Representation before the National Revenue Administration, the administrative courts, the Constitutional Tribunal and the CJEU in tax assessment cases, tax refunds and third-party liability.</p>
      </div>

      <div class="service-card reveal reveal-d3">
        <div class="service-num">04</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <p class="service-title">Support for board members</p>
        <p class="service-desc">We advise management boards of companies on managing their fiscal penal and financial liability. We analyse the risks, develop protection strategies and represent them in proceedings.</p>
      </div>

      <div class="service-card reveal">
        <div class="service-num">05</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
        <p class="service-title">Tax and personal risks</p>
        <p class="service-desc">Advice on assessing and managing taxpayers’ tax risk and individuals’ fiscal penal risk. We identify threats and develop a strategy to minimise them.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">06</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
        <p class="service-title">Fiscal penal proceedings</p>
        <p class="service-desc">Representation in fiscal penal cases at every stage – from pre-trial proceedings to the district court. Defence of individuals and legal entities in fiscal penal proceedings.</p>
      </div>

      <div class="service-card reveal reveal-d2">
        <div class="service-num">07</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="12" y2="17"/></svg></div>
        <p class="service-title">Tax procedures</p>
        <p class="service-desc">We design and implement internal tax procedures that reduce the risk of disputes with the authorities. Transfer pricing policies, TP documentation and other reporting obligations.</p>
      </div>

      <div class="service-card reveal reveal-d3">
        <div class="service-num">08</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg></div>
        <p class="service-title">Working with tax authorities</p>
        <p class="service-desc">Advice on individual tax rulings, protective opinions, advance pricing agreements (APA) and cooperative compliance programmes with the National Revenue Administration.</p>
      </div>

    </div>
  </div>
</div>

<div class="forums-band">
  <div class="forums-band-inner">
    <p class="forums-title">We represent clients before the highest tax authorities and courts in Poland and Europe.</p>
    <div class="forums-grid">
      <div class="forum-item reveal">
        <p class="forum-abbr">KAS</p>
        <p class="forum-name">National Revenue Administration – all levels</p>
      </div>
      <div class="forum-item reveal reveal-d1">
        <p class="forum-abbr">WSA / NSA</p>
        <p class="forum-name">Voivodeship Administrative Courts and the Supreme Administrative Court</p>
      </div>
      <div class="forum-item reveal reveal-d2">
        <p class="forum-abbr">CJEU / General Court</p>
        <p class="forum-name">Court of Justice of the EU and the General Court in Luxembourg</p>
      </div>
      <div class="forum-item reveal reveal-d3">
        <p class="forum-abbr">TK / EC</p>
        <p class="forum-name">Constitutional Tribunal and the European Commission</p>
      </div>
    </div>
  </div>
</div>

<div class="approach-band">
  <div class="wrap">
    <div class="approach-inner">
      <div>
        <span class="label">Our approach</span>
        <h2 class="h2-sec">More than 15 years of experience.<br>Landmark judgments before the highest forums.</h2>
        <p class="lead reveal" style="margin-top:2rem">Michał Zaremba has specialised in tax audits, customs and tax audits and tax proceedings for more than 15 years. His cases have produced precedent-setting rulings of the Supreme Administrative Court and the CJEU.</p>
      </div>
      <div>
        <p class="body-text reveal reveal-d1" style="margin-bottom:1.5rem">We are not just litigators – we advise strategically from the first sign of risk. We help choose the right route: a tax ruling, a pricing agreement, a cooperative compliance programme or an assertive defence in contentious proceedings.</p>
        <p class="body-text reveal reveal-d2">We specialise in cases where the standard approach is not enough – complex corporate structures, cross-border transactions, transfer pricing and fiscal penal proceedings against management boards.</p>
      </div>
    </div>
  </div>
</div>

<div class="team-section">
  <div class="wrap">
    <div class="row-between" style="margin-bottom:4rem">
      <div>
        <span class="label">Our team</span>
        <h2 class="h2-sec">Lawyers specialising<br>in Tax Disputes</h2>
      </div>
      <a href="/en/our-team" class="btn-row-link">
        Whole team
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
    <div class="team-grid-2p">

      <PracticeTeam lang="en" practice="spory-podatkowe" />

    </div>
  </div>
</div><div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label">Contact us</span>
      <h2 class="kt-h2">A tax audit<br>or a dispute with the authorities?</h2>
      <p class="kt-lead reveal reveal-d1">The earlier we get involved, the better. Call or write – we arrange meetings in person and online.</p>
      <div class="btn-row reveal reveal-d2" style="justify-content:center">
        <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">+48 22 319 47 60</a>
        <a href="/en/contact" class="btn-s">Contact form</a>
      </div>
    </div>
  </div>
</div>

  <Fragment slot="scripts">
<script is:inline>
(function(){
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}
  document.documentElement.classList.add('js-ready');
  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){
            setTimeout(function(){li.classList.add('visible');},idx*110);
          });
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }
})();
</script>
  </Fragment>
</BaseLayout>
