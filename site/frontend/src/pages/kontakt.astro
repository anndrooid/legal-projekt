---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/kontakt.css";
---

<BaseLayout title="Kontakt – ZMW Legal" active="/kontakt">
<!-- PAGE HEADER -->
<div class="page-header">
  <div class="page-header-inner">
    <div class="ph-left">
      <a href="/" class="ph-back reveal">‹ Strona główna</a>
      <h1 class="ph-title">Kontakt</h1>
    </div>
    <div class="ph-right">
      <p class="ph-desc reveal reveal-d1">Zapraszamy na spotkania stacjonarne lub online – wyłącznie po wcześniejszym umówieniu terminu. Najszybszy kontakt: telefon. Odpowiadamy tego samego dnia roboczego.</p>
    </div>
  </div>
</div>

<!-- CONTACT -->
<div class="contact-section">
  <div class="wrap">
    <div class="contact-layout">

      <!-- LEWA: DANE + MAPA -->
      <div class="contact-info">

        <div class="info-phone-block">
          <span class="info-phone-label">Telef0n</span>
          <a href="tel:+48223194760" class="info-phone-num" style="white-space:nowrap">+48 22 319 47 60</a>
          <p class="info-phone-note">Pon.–Pt., 9:30–17:30</p>
        </div>

        <div class="info-rows">
          <div class="info-row">
            <span class="info-row-lbl">Email</span>
            <div class="info-row-val">
              <a href="mailto:biuro@zmwlegal.pl" style="white-space:nowrap">biuro@zmwlegal.pl</a>
            </div>
          </div>
          <div class="info-row">
            <span class="info-row-lbl">Adres</span>
            <div class="info-row-val">
              ul. Wspólna 47A, III piętro<br>
              00-684 Warszawa
            </div>
          </div>
          <div class="info-row">
            <span class="info-row-lbl">Godziny pracy</span>
            <div class="info-hours">
              <div class="info-hours-row"><span>Poniedziałek–Piątek</span><span>9:30–17:30</span></div>
              <div class="info-hours-row"><span>Sobota–Niedziela</span><span>Nieczynne</span></div>
            </div>
          </div>
          <div class="info-row">
            <span class="info-row-lbl">LinkedIn</span>
            <div class="info-row-val">
              <a href="#">ZMW Legal na LinkedIn</a>
            </div>
          </div>
        </div>

        <!-- MAPA – wbudowana mapa Google -->
        <div class="map-placeholder" style="position:relative">
          <iframe src="https://www.google.com/maps?q=ul.+Wspólna+47A,+00-684+Warszawa&output=embed" style="border:0;width:100%;height:100%;display:block" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mapa – ZMW Legal, ul. Wspólna 47A, Warszawa"></iframe>
          <a href="https://maps.google.com/?q=ul.+Wspólna+47A,+00-684+Warszawa" target="_blank" rel="noopener" style="position:absolute;bottom:.75rem;right:.75rem;background:#fff;border:1px solid #e8e8e8;border-radius:6px;padding:.3rem .7rem;font-size:.7rem;font-weight:600;color:#333;text-decoration:none">Otwórz w Google Maps ↗</a>
        </div>

      </div>

      <!-- PRAWA: FORMULARZ -->
      <div class="contact-form-wrap">
        <h2 class="form-title">Napisz do nas</h2>
        <p class="form-subtitle">Odpowiadamy tego samego dnia roboczego. W pilnych sprawach – zadzwoń.</p>

        <form class="form" onsubmit="return false">
          <div class="form-row">
            <div class="form-field">
              <label for="company">Firma / organizacja <span class="form-optional">(opcjonalnie)</span></label>
              <input type="text" id="company" placeholder="Nazwa spółki">
            </div>
            <div class="form-field">
              <label for="name">Imię i nazwisko</label>
              <input type="text" id="name" placeholder="Jan Kowalski">
            </div>
          </div>

          <div class="form-field">
            <label for="email">Adres e-mail</label>
            <input type="email" id="email" placeholder="jan@firma.pl">
          </div>

          <div class="form-field">
            <label for="phone">Telefon <span class="form-optional">(opcjonalnie)</span></label>
            <input type="tel" id="phone" placeholder="+48 000 000 000">
          </div>

          <div class="form-field">
            <label for="message">Treść wiadomości</label>
            <textarea id="message" placeholder="Opisz krótko swoją sprawę lub pytanie…"></textarea>
          </div>

          <!-- CAPTCHA MATEMATYCZNA -->
          <div class="form-field">
            <label>Weryfikacja</label>
            <div class="captcha-field">
              <span class="captcha-question">Ile to:</span>
              <span class="captcha-eq">7 + 3 =</span>
              <input type="text" class="captcha-input" placeholder="?">
              <span class="captcha-note">Ochrona przed spamem</span>
            </div>
          </div>

          <p class="form-consent">Wysyłając wiadomość, akceptujesz <a href="/polityka-prywatnosci">Politykę prywatności</a>. Dane przetwarzamy wyłącznie w celu odpowiedzi na zapytanie.</p>

          <div>
            <button type="submit" class="btn-p">Wyślij wiadomość</button>
          </div>
        </form>

        <!-- SUCCESS STATE – widoczny po wysłaniu formularza -->
        <div style="display:none;margin-top:2rem;padding:2.5rem;background:#f0f9f4;border:1.5px solid #b6e6cb;border-radius:12px;text-align:center" id="formSuccess">
          <div style="width:52px;height:52px;border-radius:50%;background:#22c55e;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem">
            <svg viewBox="0 0 20 20" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M4 10l5 5 7-7"/></svg>
          </div>
          <h3 style="font-size:1.25rem;font-weight:700;color:#111;margin-bottom:.5rem">Wiadomość wysłana!</h3>
          <p style="font-size:.95rem;color:#555;line-height:1.65;margin-bottom:1.5rem">Dziękujemy za kontakt. Odpiszemy tego samego dnia roboczego.<br>W pilnych sprawach zadzwoń: <a href="tel:+48223194760" style="white-space:nowrap;color:#111;font-weight:600">+48 22 319 47 60</a></p>
          <button onclick="document.getElementById('formSuccess').style.display='none'" class="btn-s" style="font-size:.875rem">Wyślij kolejną wiadomość</button>
        </div>
        <p style="font-size:.75rem;color:#aaa;margin-top:.75rem"><em>[Wireframe: po wysłaniu formularza pokazuje się powyższy ekran sukcesu zamiast formularza]</em></p>
      </div>

    </div>
  </div>
</div>

<!-- FOOTER -->

  <Fragment slot="scripts">
<script is:inline>
(function(){
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}
  document.documentElement.classList.add('js-ready');
  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){setTimeout(function(){li.classList.add('visible');},idx*110);});
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }
})();
</script>
  </Fragment>
</BaseLayout>
