---
import BaseLayout from "../layouts/BaseLayout.astro";
import PracticeTeam from "../components/PracticeTeam.astro";
import "../styles/pages/rozwiazywanie-sporow.css";
---

<BaseLayout title="Rozwiązywanie Sporów – ZMW Legal" active="/rozwiazywanie-sporow">
<!-- PAGE HEADER -->
<div class="page-header">
  <div class="page-header-inner">
    <div class="ph-left">
      <a href="/" class="ph-back reveal">‹ Praktyki</a>
      <h1 class="ph-title">Rozwiązywanie<br>Sporów</h1>
    </div>
    <div class="ph-right">
      <p class="ph-desc reveal reveal-d1">Zapewniamy kompleksowe wsparcie prawne na każdym etapie sporu. Skutecznie reprezentujemy Klientów przed trybunałami arbitrażowymi, sądami powszechnymi i organami administracji publicznej.</p>
      <p class="ph-desc reveal reveal-d2" style="margin-top:1.5rem">Nasza praktyka wykracza poza salę sądową – obejmuje codzienną analizę ryzyka, doradztwo strategiczne i wsparcie wewnętrznych działów prawnych.</p>
      <div class="ph-tags reveal reveal-d3">
        <span class="ph-tag">Spory korporacyjne</span>
        <span class="ph-tag">Arbitraż</span>
        <span class="ph-tag">Sądy powszechne</span>
        <span class="ph-tag">Postępowania administracyjne</span>
      </div>
    </div>
  </div>
</div>

<!-- SERVICES -->
<div class="services-section">
  <div class="wrap">
    <div class="row-between">
      <div>
        <span class="label">Zakres usług</span>
        <h2 class="h2-sec">Co robimy</h2>
      </div>
    </div>
    <div class="services-grid">

      <div class="service-card reveal">
        <div class="service-num">01</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="3" x2="12" y2="21"/><line x1="9" y1="21" x2="15" y2="21"/><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="8" x2="1" y2="14"/><line x1="4" y1="8" x2="7" y2="14"/><path d="M1 14q3 4 6 0"/><line x1="20" y1="8" x2="17" y2="14"/><line x1="20" y1="8" x2="23" y2="14"/><path d="M17 14q3 4 6 0"/></svg></div>
        <p class="service-title">Strategia</p>
        <p class="service-desc">Budujemy kompleksowe, zindywidualizowane strategie procesowe, których celem jest maksymalizacja szans na korzystne rozstrzygnięcie przy jednoczesnym minimalizowaniu kosztów i czasu trwania sporu.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">02</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 9 12 3 21 9"/><path d="M3 9v12h18V9"/><line x1="7" y1="13" x2="7" y2="21"/><line x1="12" y1="13" x2="12" y2="21"/><line x1="17" y1="13" x2="17" y2="21"/></svg></div>
        <p class="service-title">Reprezentacja</p>
        <p class="service-desc">Reprezentujemy Klientów przed sądami powszechnymi wszystkich instancji, trybunałami arbitrażowymi (krajowymi i międzynarodowymi) oraz organami administracji państwowej i regulatorami.</p>
      </div>

      <div class="service-card reveal reveal-d2">
        <div class="service-num">03</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <p class="service-title">Zarządzanie ryzykiem</p>
        <p class="service-desc">Doradzamy wewnętrznym działom prawnym i compliance w zakresie identyfikacji, oceny i zarządzania ryzykiem prawnym związanym z prowadzoną działalnością. Pomagamy wdrożyć procesy minimalizujące ryzyko przyszłych sporów.</p>
      </div>

      <div class="service-card reveal reveal-d3">
        <div class="service-num">04</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
        <p class="service-title">Zabezpieczenie roszczeń</p>
        <p class="service-desc">Doradzamy i reprezentujemy w postępowaniach o zabezpieczenie roszczeń przed wszczęciem lub w trakcie procesu. Działamy szybko i skutecznie – zabezpieczenie roszczeń często decyduje o faktycznym wyniku sporu.</p>
      </div>

      <div class="service-card reveal">
        <div class="service-num">05</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><line x1="10" y1="14" x2="3" y2="21"/><line x1="21" y1="3" x2="14" y2="10"/></svg></div>
        <p class="service-title">Zapobieganie eskalacji sporu</p>
        <p class="service-desc">Opracowujemy strategie zarządzania ryzykiem minimalizujące zagrożenia organizacyjne, pracownicze i kontraktowe. Skuteczna de-eskalacja sporu – negocjacje, mediacja i ugoda – często jest lepszym rozwiązaniem niż długotrwały proces.</p>
      </div>

    </div>
  </div>
</div>

<!-- APPROACH / OPIS PRAKTYKI -->
<div class="approach-band">
  <div class="wrap">
    <div class="approach-inner">
      <div>
        <span class="label">Nasze podejście</span>
        <h2 class="h2-sec">Spory korporacyjne, arbitraż<br>i postępowania administracyjne.</h2>
        <div class="approach-stat">
          <div class="stat-item">
            <div class="stat-num">20+</div>
            <div class="stat-lbl">lat doświadczenia<br>w sporach</div>
          </div>
          <div class="stat-item">
            <div class="stat-num">Band 1</div>
            <div class="stat-lbl">Legal 500 EMEA<br>Dispute Resolution</div>
          </div>
        </div>
      </div>
      <div>
        <p class="lead reveal" style="margin-bottom:2rem">Nasze doświadczenie obejmuje złożone spory handlowe i regulacyjne, w tym postępowania dotyczące wspólników, organów spółek i inwestorów – również w kontekście transgranicznym.</p>
        <p class="body-text reveal reveal-d1" style="margin-bottom:1.5rem">Łączymy precyzję analityczną z agresywną, skuteczną reprezentacją. Rozumiemy, że dla naszych Klientów spór to nie tylko kwestia prawna – to realne ryzyko biznesowe, które wymaga strategicznego myślenia od pierwszego dnia.</p>
        <p class="body-text reveal reveal-d2">Każda sprawa to indywidualna strategia. Oceniamy szanse i ryzyka rzetelnie – doradzamy nie tylko wtedy, kiedy warto walczyć, ale też kiedy warto osiągnąć ugodę.</p>
      </div>
    </div>
  </div>
</div>

<!-- RANKINGS & QUOTES -->
<div class="rankings-section">
  <div class="rankings-inner">
    <div class="rankings-header">
      <h2 class="rankings-title">Co mówią o nas<br>niezależne rankingi</h2>
    </div>
    <div class="quotes-grid">

      <div class="quote-card reveal">
        <p class="quote-source">Legal 500 EMEA · Dispute Resolution</p>
        <p class="quote-text">„Zespół wyróżnia się kompetencjami w zakresie litigation przy silnym rozumieniu biznesowym i efektywną współpracą. Prowadzi złożone, precedensowe sprawy z innowacyjnymi rozwiązaniami."</p>
        <p class="quote-about">O kancelarii ZMW Legal</p>
      </div>

      <div class="quote-card reveal reveal-d1">
        <p class="quote-source">Legal 500 EMEA · Dispute Resolution</p>
        <p class="quote-text">„Wysoko wykwalifikowani Partnerzy i Associates łączący doświadczenie z kancelarii międzynarodowych z elastycznością kancelarii butikowej."</p>
        <p class="quote-about">O kancelarii ZMW Legal</p>
      </div>

      <div class="quote-card reveal reveal-d2">
        <p class="quote-source">Chambers &amp; Partners · Prof. Anna Zawadzka</p>
        <p class="quote-text">„Dogłębna analiza problemu, dostarczanie szerokiego wachlarza opcji i ścieżek działania. Klientów imponuje strategiczne podejście już na etapie planowania sporu."</p>
        <p class="quote-about">Managing Partner · Band 1</p>
      </div>

      <div class="quote-card reveal reveal-d3">
        <p class="quote-source">Chambers &amp; Partners · Piotr Mrowiec</p>
        <p class="quote-text">„Klienci doceniają poziom merytoryczny, proaktywne zaangażowanie i kompleksowe podejście. Unikalne doświadczenie w wielomilionowych sporach na forach krajowych i międzynarodowych."</p>
        <p class="quote-about">Partner · Band 2</p>
      </div>

    </div>
  </div>
</div>

<!-- TEAM -->
<div class="team-section">
  <div class="wrap">
    <div class="row-between" style="margin-bottom:4rem">
      <div>
        <span class="label">Nasz zespół</span>
        <h2 class="h2-sec">Prawnicy specjalizujący się<br>w Rozwiązywaniu Sporów</h2>
      </div>
      <a href="/nasz-zespol" class="btn-row-link">
        Cały zespół
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
    <div class="team-grid-prac">

      <PracticeTeam practice="rozwiazywanie-sporow" />

    </div>
  </div>
</div>

<!-- CTA -->
<div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label">Skontaktuj się z nami</span>
      <h2 class="kt-h2">Masz sprawę<br>do rozwiązania?</h2>
      <p class="kt-lead reveal reveal-d1">Rozmawiamy konkretnie i bez zbędnych formalności. Zadzwoń lub napisz – umawiamy spotkania stacjonarne i online.</p>
      <div class="btn-row reveal reveal-d2" style="justify-content:center">
        <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">+48 22 319 47 60</a>
        <a href="/kontakt" class="btn-s">Formularz kontaktowy</a>
      </div>
    </div>
  </div>
</div>

<!-- FOOTER -->

  <Fragment slot="scripts">
<script is:inline>
(function(){
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}
  document.documentElement.classList.add('js-ready');
  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){
            setTimeout(function(){li.classList.add('visible');},idx*110);
          });
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }
})();
</script>
  </Fragment>
</BaseLayout>
