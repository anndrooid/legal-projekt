---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/life-sciences.css";
---

<BaseLayout title="Life Sciences – ZMW Legal" active="/life-sciences">
<div class="page-header">
  <div class="page-header-inner">
    <div>
      <a href="/" class="ph-back reveal">‹ Praktyki</a>
      <h1 class="ph-title">Life<br>Sciences</h1>
    </div>
    <div>
      <p class="ph-desc reveal reveal-d1">Przekładamy złożone regulacje farmaceutyczne i żywnościowe na praktyczne rozwiązania. Wspieramy klientów na każdym etapie działalności – od planowania i uzyskiwania zezwoleń po certyfikacje i audyty.</p>
      <p class="ph-desc reveal reveal-d2" style="margin-top:1.5rem">Identyfikujemy potencjalne ryzyka i skutecznie je minimalizujemy – zarówno w codziennej działalności, jak i w sytuacjach kryzysowych.</p>
      <div class="ph-tags reveal reveal-d3">
        <span class="ph-tag">Produkty lecznicze</span>
        <span class="ph-tag">Suplementy diety</span>
        <span class="ph-tag">Audyty GMP</span>
        <span class="ph-tag">Rejestracja produktów</span>
        <span class="ph-tag">Prawo farmaceutyczne</span>
      </div>
    </div>
  </div>
</div>

<div class="services-section">
  <div class="wrap">
    <div class="row-between">
      <div>
        <span class="label">Zakres usług</span>
        <h2 class="h2-sec">Jak możemy<br>pomóc</h2>
      </div>
    </div>
    <div class="services-grid">

      <div class="service-card reveal">
        <div class="service-num">01</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg></div>
        <p class="service-title">Doradztwo Strategiczne</p>
        <p class="service-desc">Wsparcie w krótko- i długoterminowym planowaniu zarządzania przedsiębiorstwem i rozwojem produktów. Modele dystrybucji leków w Polsce i na rynkach globalnych, działalność importerów równoległych w UE, import leków na choroby rzadkie.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">02</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="12" y2="17"/></svg></div>
        <p class="service-title">Analizy i Opinie Prawne</p>
        <p class="service-desc">Szczegółowe analizy legislacyjne i raporty dotyczące praktyki organów regulacyjnych w Polsce. Opinie prawne analizujące regulacje na tle konkretnych stanów faktycznych i prezentujące możliwe ścieżki działania.</p>
      </div>

      <div class="service-card reveal reveal-d2">
        <div class="service-num">03</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6"/><path d="M10 3v5L5 17a1 1 0 00.9 1.5h12.2a1 1 0 00.9-1.5L14 8V3"/><path d="M6.5 15h11"/></svg></div>
        <p class="service-title">Produkty Lecznicze</p>
        <p class="service-desc">Doradztwo regulacyjne na każdym etapie: badania (B+R, badania kliniczne), procedury rejestracyjne, wprowadzenie do obrotu, zmiany porejestracyjne i monitoring compliance. Wsparcie przy zawieszeniu lub wycofaniu produktów z rynku.</p>
      </div>

      <div class="service-card reveal reveal-d3">
        <div class="service-num">04</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><polyline points="9 12 11 14 15 10"/></svg></div>
        <p class="service-title">Audyty</p>
        <p class="service-desc">Audyty jakościowe w wytwórniach farmaceutycznych i hurtowniach oceniające zgodność z przepisami. Przeprowadzane u klienta lub w jego imieniu u podwykonawców i kontraktowych wytwórców – w Polsce, UE, Azji i Ameryce Płn.</p>
      </div>

      <div class="service-card reveal">
        <div class="service-num">05</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="3" x2="12" y2="21"/><line x1="9" y1="21" x2="15" y2="21"/><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="8" x2="1" y2="14"/><line x1="4" y1="8" x2="7" y2="14"/><path d="M1 14q3 4 6 0"/><line x1="20" y1="8" x2="17" y2="14"/><line x1="20" y1="8" x2="23" y2="14"/><path d="M17 14q3 4 6 0"/></svg></div>
        <p class="service-title">Postępowania Prawne</p>
        <p class="service-desc">Reprezentacja klientów w sądach administracyjnych i powszechnych. Sprawy dotyczące działalności regulowanej (zezwolenia, licencje, postępowania porejestracyjne, rejestracja i refundacja), sprawy celno-podatkowe i środowiskowe.</p>
      </div>

      <div class="service-card reveal reveal-d1">
        <div class="service-num">06</div>
        <div class="service-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></div>
        <p class="service-title">Żywność i Suplementy Diety</p>
        <p class="service-desc">Wsparcie podmiotów wprowadzających żywność lub suplementy diety do obrotu. Kontakty z organami regulacyjnymi, przeglądy składu produktów, opiniowanie tekstów opakowań i reklam, postępowania przed organami inspekcji sanitarnej.</p>
      </div>

    </div>
  </div>
</div>

<div class="approach-band">
  <div class="wrap">
    <div class="approach-inner">
      <div>
        <span class="label">Nasze doświadczenie</span>
        <h2 class="h2-sec">Prawo farmaceutyczne i żywnościowe –<br>przez cały cykl życia produktu.</h2>
        <p class="lead reveal" style="margin-top:2rem">Doradzamy na każdym etapie – od fazy B+R i badań klinicznych przez rejestrację, dystrybucję aż po sytuacje kryzysowe i postępowania sporne.</p>
      </div>
      <div>
        <div class="approach-list">
          <div class="approach-item reveal">
            <div class="approach-item-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg></div>
            <div class="approach-item-text">
              <p class="approach-item-title">Audyty na 4 kontynentach</p>
              <p class="approach-item-desc">Doświadczenie w audytach GMP w Polsce, krajach UE, Azji i Ameryce Północnej.</p>
            </div>
          </div>
          <div class="approach-item reveal reveal-d1">
            <div class="approach-item-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg></div>
            <div class="approach-item-text">
              <p class="approach-item-title">Pełny cykl regulacyjny</p>
              <p class="approach-item-desc">Od B+R i badań klinicznych przez rejestrację, dystrybucję po zmiany porejestracyjne i wycofanie produktu.</p>
            </div>
          </div>
          <div class="approach-item reveal reveal-d2">
            <div class="approach-item-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></div>
            <div class="approach-item-text">
              <p class="approach-item-title">Przekrój rynku</p>
              <p class="approach-item-desc">Obsługujemy producentów, importerów równoległych, hurtownie, dystrybutorów i podmioty rejestrujące.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="team-section">
  <div class="wrap">
    <div class="row-between" style="margin-bottom:4rem">
      <div>
        <span class="label">Nasz zespół</span>
        <h2 class="h2-sec">Prawnicy specjalizujący się<br>w Life Sciences</h2>
      </div>
      <a href="/nasz-zespol" class="btn-row-link">
        Cały zespół
        <span class="btn-c"><span class="arr"></span></span>
      </a>
    </div>
    <div class="team-grid-prac">

      <div class="team-card reveal">
        <div class="team-photo"><img src="/images/team/karolina-rychlewska.webp" alt="Karolina Rychlewska" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:55% 20%;display:block;border-radius:inherit"></div>
        <div class="team-body">
          <span class="team-badge">Lider praktyki</span>
          <p class="team-name">Karolina Rychlewska</p>
          <p class="team-role">Partner</p>
          <a href="/zespol/karolina-rychlewska" class="btn-row-link" style="font-size:.8rem;gap:.4rem;margin-top:.85rem">Profil <span class="btn-c btn-c-sm"><span class="arr"></span></span></a>
        </div>
      </div>

      <div class="team-card reveal reveal-d1">
        <div class="team-photo"><img src="/images/team/joanna-stachowiak.webp" alt="Joanna Stachowiak" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:50% 15%;display:block;border-radius:inherit"></div>
        <div class="team-body">
          <span class="team-badge" style="opacity:0">–</span>
          <p class="team-name">Joanna Stachowiak</p>
          <p class="team-role">Associate</p>
          <a href="/zespol/joanna-stachowiak" class="btn-row-link" style="font-size:.8rem;gap:.4rem;margin-top:.85rem">Profil <span class="btn-c btn-c-sm"><span class="arr"></span></span></a>
        </div>
      </div>

      <div class="team-card reveal reveal-d2">
        <div class="team-photo"><img src="/images/team/lukasz-baran.webp" alt="Łukasz Baran" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:50% 15%;display:block;border-radius:inherit"></div>
        <div class="team-body">
          <span class="team-badge" style="opacity:0">–</span>
          <p class="team-name">Łukasz Baran</p>
          <p class="team-role">Counsel</p>
          <a href="/zespol/lukasz-baran" class="btn-row-link" style="font-size:.8rem;gap:.4rem;margin-top:.85rem">Profil <span class="btn-c btn-c-sm"><span class="arr"></span></span></a>
        </div>
      </div>

      <div class="team-card reveal reveal-d3">
        <div class="team-photo"><img src="/images/team/krzysztof-kowal.webp" alt="Krzysztof Kowal" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:50% 15%;display:block;border-radius:inherit"></div>
        <div class="team-body">
          <span class="team-badge" style="opacity:0">–</span>
          <p class="team-name">Krzysztof Kowal</p>
          <p class="team-role">Senior Associate</p>
          <a href="/zespol/krzysztof-kowal" class="btn-row-link" style="font-size:.8rem;gap:.4rem;margin-top:.85rem">Profil <span class="btn-c btn-c-sm"><span class="arr"></span></span></a>
        </div>
      </div>

      <div class="team-card reveal reveal-d4">
        <div class="team-photo"><img src="/images/team/marek-debowski.webp" alt="Marek Dębowski" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;object-position:50% 15%;display:block;border-radius:inherit"></div>
        <div class="team-body">
          <span class="team-badge" style="opacity:0">–</span>
          <p class="team-name">Marek Dębowski</p>
          <p class="team-role">Project Manager</p>
          <a href="/zespol/marek-debowski" class="btn-row-link" style="font-size:.8rem;gap:.4rem;margin-top:.85rem">Profil <span class="btn-c btn-c-sm"><span class="arr"></span></span></a>
        </div>
      </div>

    </div>
  </div>
</div><div class="cta-sec">
  <div class="wrap">
    <div class="cta-inner">
      <span class="label">Skontaktuj się z nami</span>
      <h2 class="kt-h2">Pytania o regulacje<br>farmaceutyczne lub żywnościowe?</h2>
      <p class="kt-lead reveal reveal-d1">Rozmawiamy konkretnie i bez zbędnych formalności. Zadzwoń lub napisz – umawiamy spotkania stacjonarne i online.</p>
      <div class="btn-row reveal reveal-d2" style="justify-content:center">
        <a href="tel:+48223194760" class="btn-p" style="white-space:nowrap">+48 22 319 47 60</a>
        <a href="/kontakt" class="btn-s">Formularz kontaktowy</a>
      </div>
    </div>
  </div>
</div>

  <Fragment slot="scripts">
<script is:inline>
(function(){
  var h=document.getElementById('hamburger'),m=document.getElementById('mobileMenu'),c=document.getElementById('mobileClose'),pt=document.getElementById('mobilePraktyki'),ps=document.getElementById('mobileSubmenu');
  if(h&&m){h.addEventListener('click',function(){m.classList.add('open');document.body.style.overflow='hidden';});}
  if(c&&m){c.addEventListener('click',function(){m.classList.remove('open');document.body.style.overflow='';});}
  if(pt&&ps){pt.addEventListener('click',function(){ps.classList.toggle('open');this.classList.toggle('open');});}
  document.documentElement.classList.add('js-ready');
  var noMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(window.IntersectionObserver&&!noMotion){
    var hio=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          e.target.querySelectorAll('.line-inner').forEach(function(li,idx){
            setTimeout(function(){li.classList.add('visible');},idx*110);
          });
          hio.unobserve(e.target);
        }
      });
    },{threshold:0,rootMargin:'0px 0px -25% 0px'});
    document.querySelectorAll('.h2-sec,.kt-h2,.ph-title,.art-title,.rankings-title,.stats-header-title,.forums-title').forEach(function(el){
      var _segs=el.innerHTML.split(/<br\s*\/?>/i).map(function(s){return s.trim();});
      var _markup=_segs.map(function(seg){return seg.split(/\s+/).filter(Boolean).map(function(w){return '<span class="_word">'+w+'</span>';}).join(' ');}).join('<br>');
      el.innerHTML=_markup;
      var _lines=[],_curTop=null,_curWords=[];
      el.querySelectorAll('._word').forEach(function(w){
        var top=w.offsetTop;
        if(_curTop===null){_curTop=top;}
        if(Math.abs(top-_curTop)>2){_lines.push(_curWords.join(' '));_curWords=[];_curTop=top;}
        _curWords.push(w.textContent);
      });
      if(_curWords.length)_lines.push(_curWords.join(' '));
      el.innerHTML=_lines.map(function(l){return '<span class="line-clip"><span class="line-inner">'+l+'</span></span>';}).join('');
      el.classList.remove('reveal','reveal-d1','reveal-d2','reveal-d3');
      hio.observe(el);
    });
  }
  if(window.IntersectionObserver){
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}});
    },{threshold:0,rootMargin:'0px 0px -18% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('visible');});
  }
})();
</script>
  </Fragment>
</BaseLayout>
