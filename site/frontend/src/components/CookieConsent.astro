---
// Baner zgód na pliki cookie (RODO / Prawo komunikacji elektronicznej).
// - „Odrzuć” jest równie dostępne jak „Akceptuj wszystkie”
// - wybór zapisywany w jednym niezbędnym cookie `zmw_consent` (12 miesięcy)
// - skrypty oznaczone <script type="text/plain" data-cookie-category="analytics|marketing">
//   uruchamiają się dopiero po zgodzie na daną kategorię
// - link z atrybutem data-cookie-settings (np. w stopce) ponownie otwiera ustawienia
import { path, type Lang } from "../data/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t =
  lang === "en"
    ? {
        title: "We respect your privacy",
        desc: "We use cookies that are necessary for the website to work. With your consent, we may also use analytics and marketing cookies. Details in our",
        policy: "privacy policy",
        necessary: ["Necessary", "Remembering your cookie choice. Always active."],
        analytics: ["Analytics", "Anonymous visit statistics that help us improve the website."],
        marketing: ["Marketing", "Tailoring content and messages to your interests."],
        accept: "Accept all",
        reject: "Reject",
        settings: "Settings",
        hide: "Hide settings",
        save: "Save choice",
      }
    : {
        title: "Szanujemy Twoją prywatność",
        desc: "Używamy plików cookie niezbędnych do działania strony. Za Twoją zgodą możemy też używać cookies analitycznych i marketingowych. Szczegóły w",
        policy: "polityce prywatności",
        necessary: ["Niezbędne", "Zapamiętanie Twojego wyboru dotyczącego cookies. Zawsze aktywne."],
        analytics: ["Analityczne", "Anonimowe statystyki odwiedzin, które pomagają nam ulepszać stronę."],
        marketing: ["Marketingowe", "Dopasowanie treści i komunikatów do Twoich zainteresowań."],
        accept: "Akceptuj wszystkie",
        reject: "Odrzuć",
        settings: "Ustawienia",
        hide: "Ukryj ustawienia",
        save: "Zapisz wybór",
      };
---

<div class="cc" id="cookieConsent" data-label-settings={t.settings} data-label-hide={t.hide} role="dialog" aria-modal="false" aria-labelledby="ccTitle" aria-describedby="ccDesc" hidden>
  <div class="cc-main">
    <p class="cc-title" id="ccTitle">{t.title}</p>
    <p class="cc-desc" id="ccDesc">
      {t.desc} <a href={`${path("privacy", lang)}#s7`}>{t.policy}</a>.
    </p>

    <div class="cc-settings" id="ccSettings" hidden>
      <label class="cc-cat">
        <span class="cc-cat-text">
          <span class="cc-cat-name">{t.necessary[0]}</span>
          <span class="cc-cat-desc">{t.necessary[1]}</span>
        </span>
        <input type="checkbox" checked disabled />
        <span class="cc-switch" aria-hidden="true"></span>
      </label>
      <label class="cc-cat">
        <span class="cc-cat-text">
          <span class="cc-cat-name">{t.analytics[0]}</span>
          <span class="cc-cat-desc">{t.analytics[1]}</span>
        </span>
        <input type="checkbox" data-cc-category="analytics" />
        <span class="cc-switch" aria-hidden="true"></span>
      </label>
      <label class="cc-cat">
        <span class="cc-cat-text">
          <span class="cc-cat-name">{t.marketing[0]}</span>
          <span class="cc-cat-desc">{t.marketing[1]}</span>
        </span>
        <input type="checkbox" data-cc-category="marketing" />
        <span class="cc-switch" aria-hidden="true"></span>
      </label>
    </div>

    <div class="cc-actions">
      <button type="button" class="cc-btn cc-btn-primary" data-cc="accept">{t.accept}</button>
      <button type="button" class="cc-btn" data-cc="reject">{t.reject}</button>
      <button type="button" class="cc-btn cc-btn-link" data-cc="toggle" aria-expanded="false" aria-controls="ccSettings">{t.settings}</button>
      <button type="button" class="cc-btn cc-btn-primary" data-cc="save" hidden>{t.save}</button>
    </div>
  </div>
</div>

<script is:inline>
(function(){
  var NAME='zmw_consent', VERSION=1, MAX_AGE=60*60*24*365;
  var box=document.getElementById('cookieConsent');
  if(!box)return;
  var settings=document.getElementById('ccSettings');
  var toggles=box.querySelectorAll('[data-cc-category]');
  var btn=function(a){return box.querySelector('[data-cc="'+a+'"]');};

  function read(){
    var m=document.cookie.match(new RegExp('(?:^|; )'+NAME+'=([^;]*)'));
    if(!m)return null;
    try{var v=JSON.parse(decodeURIComponent(m[1]));return v.v===VERSION?v:null;}catch(e){return null;}
  }
  function write(c){
    var v={v:VERSION,analytics:!!c.analytics,marketing:!!c.marketing,date:new Date().toISOString()};
    document.cookie=NAME+'='+encodeURIComponent(JSON.stringify(v))+'; Max-Age='+MAX_AGE+'; Path=/; SameSite=Lax'+(location.protocol==='https:'?'; Secure':'');
    return v;
  }
  // Uruchamia skrypty czekające na zgodę danej kategorii
  function apply(c){
    document.querySelectorAll('script[type="text/plain"][data-cookie-category]').forEach(function(s){
      if(!c[s.dataset.cookieCategory]||s.dataset.ccLoaded)return;
      var n=document.createElement('script');
      for(var i=0;i<s.attributes.length;i++){var a=s.attributes[i];if(a.name!=='type')n.setAttribute(a.name,a.value);}
      n.text=s.text;s.dataset.ccLoaded='1';s.after(n);
    });
    window.dispatchEvent(new CustomEvent('zmw:consent',{detail:c}));
  }
  function open(showSettings){
    var c=read()||{};
    toggles.forEach(function(t){t.checked=!!c[t.dataset.ccCategory];});
    setSettings(!!showSettings);
    box.hidden=false;
    requestAnimationFrame(function(){box.classList.add('cc-visible');});
  }
  function close(){
    box.classList.remove('cc-visible');
    setTimeout(function(){box.hidden=true;},250);
  }
  function setSettings(on){
    settings.hidden=!on;
    btn('toggle').setAttribute('aria-expanded',on);
    btn('toggle').textContent=on?box.dataset.labelHide:box.dataset.labelSettings;
    btn('save').hidden=!on;
    btn('accept').hidden=on;
  }
  function decide(c){apply(write(c));close();}

  btn('accept').addEventListener('click',function(){decide({analytics:true,marketing:true});});
  btn('reject').addEventListener('click',function(){decide({analytics:false,marketing:false});});
  btn('toggle').addEventListener('click',function(){setSettings(settings.hidden);});
  btn('save').addEventListener('click',function(){
    var c={};toggles.forEach(function(t){c[t.dataset.ccCategory]=t.checked;});decide(c);
  });
  document.addEventListener('click',function(e){
    var l=e.target.closest&&e.target.closest('[data-cookie-settings]');
    if(l){e.preventDefault();open(true);}
  });
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!box.hidden&&read())close();});

  // Skrypty czekające na zgodę mogą stać w HTML niżej niż baner — uruchamiamy je po wczytaniu dokumentu
  var saved=read();
  if(saved){
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){apply(saved);});
    else apply(saved);
  }else open(false);
})();
</script>

<style>
  .cc{position:fixed;left:1.5rem;bottom:1.5rem;z-index:400;width:min(440px,calc(100vw - 3rem));background:#fff;color:var(--navy,#1a2440);border:1px solid rgba(26,36,64,.12);border-radius:12px;box-shadow:0 16px 48px rgba(26,36,64,.16);font-family:'PPNeueMontreal',sans-serif;letter-spacing:.02em;opacity:0;transform:translateY(12px);transition:opacity .25s ease,transform .25s ease}
  .cc.cc-visible{opacity:1;transform:none}
  .cc-main{padding:1.5rem 1.5rem 1.35rem}
  .cc-title{font-size:1.05rem;font-weight:600;margin-bottom:.5rem}
  .cc-desc{font-size:.85rem;line-height:1.6;color:rgba(26,36,64,.75)}
  .cc-desc a{color:var(--crimson,#8C0002);text-decoration:underline;text-underline-offset:2px}
  .cc-settings{margin-top:1.1rem;border-top:1px solid rgba(26,36,64,.12)}
  .cc-cat{display:flex;align-items:center;gap:1rem;padding:.85rem 0;border-bottom:1px solid rgba(26,36,64,.08);cursor:pointer;position:relative}
  .cc-cat-text{flex:1;display:flex;flex-direction:column;gap:.15rem}
  .cc-cat-name{font-size:.85rem;font-weight:600}
  .cc-cat-desc{font-size:.75rem;line-height:1.45;color:rgba(26,36,64,.6)}
  .cc-cat input{position:absolute;opacity:0;width:1px;height:1px}
  .cc-switch{flex-shrink:0;width:38px;height:22px;border-radius:22px;background:rgba(26,36,64,.18);position:relative;transition:background .2s}
  .cc-switch::after{content:'';position:absolute;top:3px;left:3px;width:16px;height:16px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:transform .2s}
  .cc-cat input:checked + .cc-switch{background:var(--crimson,#8C0002)}
  .cc-cat input:checked + .cc-switch::after{transform:translateX(16px)}
  .cc-cat input:disabled + .cc-switch{opacity:.45;cursor:not-allowed}
  .cc-cat input:focus-visible + .cc-switch{outline:2px solid var(--navy,#1a2440);outline-offset:2px}
  .cc-actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.15rem;align-items:center}
  .cc-btn{font:inherit;font-size:.82rem;font-weight:600;padding:.65rem 1.1rem;border-radius:8px;border:1px solid rgba(26,36,64,.25);background:#fff;color:var(--navy,#1a2440);cursor:pointer;transition:background .2s,border-color .2s,color .2s}
  .cc-btn:hover{border-color:var(--navy,#1a2440)}
  .cc-btn-primary{background:var(--navy,#1a2440);border-color:var(--navy,#1a2440);color:#fff}
  .cc-btn-primary:hover{background:var(--crimson,#8C0002);border-color:var(--crimson,#8C0002)}
  .cc-btn-link{border-color:transparent;background:none;text-decoration:underline;text-underline-offset:3px;padding-left:.4rem;padding-right:.4rem}
  .cc-btn-link:hover{border-color:transparent;color:var(--crimson,#8C0002)}
  .cc-btn:focus-visible{outline:2px solid var(--crimson,#8C0002);outline-offset:2px}
  @media(max-width:480px){
    .cc{left:.75rem;right:.75rem;bottom:.75rem;width:auto}
    .cc-actions .cc-btn:not(.cc-btn-link){flex:1}
  }
  @media(prefers-reduced-motion:reduce){.cc{transition:none}}
</style>
