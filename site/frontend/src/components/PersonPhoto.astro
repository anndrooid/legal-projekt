---
import { buildSrcSet, objectPosition, urlFor } from "../utils/image";
import type { SanityImage } from "../utils/sanity";

interface Props {
  image?: SanityImage;
  alt: string;
  /** Wartość atrybutu sizes */
  sizes?: string;
  priority?: boolean;
}

const { image, alt, sizes = "(max-width: 767px) 100vw, (max-width: 1200px) 50vw, 25vw", priority = false } = Astro.props;
---

{
  image?.asset && (
    <img
      src={urlFor(image).width(600).url()}
      srcset={buildSrcSet(image, [300, 450, 600, 900])}
      sizes={sizes}
      width={image.width}
      height={image.height}
      alt={alt}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : undefined}
      decoding="async"
      style={`width:100%;height:100%;object-fit:cover;object-position:${objectPosition(image)};display:block;border-radius:inherit`}
    />
  )
}
